<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
  <Identifier>com.aivideomaker.subscription.config</Identifier>
  <Products>
    <Product>
      <Id>aivideomakerWeek</Id>
      <Type>subscription</Type>
      <Duration>7 days</Duration>
      <DisplayPrice>2.99</DisplayPrice>
      <FamilyShareable>false</FamilyShareable>
      <ReferenceName>Недельная подписка</ReferenceName>
      <Localizations>
        <Localization>
          <Language>ru</Language>
          <Title>Недельная подписка</Title>
          <Description>Полный доступ к функциям на 1 неделю.</Description>
        </Localization>
        <Localization>
          <Language>en</Language>
          <Title>Weekly Subscription</Title>
          <Description>Full access to all features for 1 week.</Description>
        </Localization>
      </Localizations>
    </Product>
    <Product>
      <Id>aivideomakerMonth</Id>
      <Type>subscription</Type>
      <Duration>1 month</Duration>
      <DisplayPrice>7.99</DisplayPrice>
      <FamilyShareable>false</FamilyShareable>
      <ReferenceName>Месячная подписка</ReferenceName>
      <Localizations>
        <Localization>
          <Language>ru</Language>
          <Title>Месячная подписка</Title>
          <Description>Полный доступ к функциям на 1 месяц.</Description>
        </Localization>
        <Localization>
          <Language>en</Language>
          <Title>Monthly Subscription</Title>
          <Description>Full access to all features for 1 month.</Description>
        </Localization>
      </Localizations>
    </Product>
    <Product>
      <Id>aivideomakerYear</Id>
      <Type>subscription</Type>
      <Duration>1 year</Duration>
      <DisplayPrice>47.99</DisplayPrice>
      <FamilyShareable>false</FamilyShareable>
      <ReferenceName>Годовая подписка с бесплатным периодом</ReferenceName>
      <TrialDuration>1 week</TrialDuration>
      <Localizations>
        <Localization>
          <Language>ru</Language>
          <Title>Годовая подписка</Title>
          <Description>Полный доступ к функциям на 1 год. Первая неделя бесплатно.</Description>
        </Localization>
        <Localization>
          <Language>en</Language>
          <Title>Yearly Subscription with Trial</Title>
          <Description>Full access to all features for 1 year. First week free.</Description>
        </Localization>
      </Localizations>
    </Product>
  </Products>
</Configuration> 