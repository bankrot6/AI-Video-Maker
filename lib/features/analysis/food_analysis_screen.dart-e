import 'dart:io';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:image_picker/image_picker.dart';
import 'package:uuid/uuid.dart';
import '../../models/nutrition_info.dart';
import '../../models/meal_model.dart';
import '../../services/providers.dart' as services;
import '../../services/analysis_service.dart';
import 'analysis_providers.dart' as analysis;
import '../../features/home/home_providers.dart' as home;
import 'dart:ui';
import '../../widgets/loading/loading_manager.dart';
import '../../widgets/edit_text/text_editing_bottom_sheet.dart';
import 'package:flutter/scheduler.dart';
import 'dart:async';
import 'package:path_provider/path_provider.dart';
import 'package:path/path.dart' as path;

/// Экран анализа питательной ценности блюда
class FoodAnalysisScreen extends ConsumerStatefulWidget {
  /// Создает экран анализа питательной ценности блюда
  ///
  /// [isVoiceInput] - флаг, указывающий, что ввод произведен с помощью голоса
  const FoodAnalysisScreen({super.key, this.isVoiceInput = false});

  /// Флаг, указывающий, что ввод произведен с помощью голоса
  final bool isVoiceInput;

  @override
  ConsumerState<FoodAnalysisScreen> createState() => _FoodAnalysisScreenState();
}

class _FoodAnalysisScreenState extends ConsumerState<FoodAnalysisScreen> {
  File? _imageFile;
  final ImagePicker _picker = ImagePicker();
  bool _isMockService = false;
  final bool _isDirectDeepSeekAnalysis = false;
  bool _isSaving = false;
  final bool _isLoadingScreenShown = false;
  final TextEditingController _dishNameController = TextEditingController();
  bool _isAnalysisInProgress = false;
  bool _isLoading = false;
  bool _analysisCompleted = false;

  @override
  void initState() {
    super.initState();

    WidgetsBinding.instance.addPostFrameCallback((_) async {
      debugPrint('🚀 FoodAnalysisScreen инициализирован');

      // Проверяем, открыт ли экран для голосового ввода
      if (widget.isVoiceInput) {
        debugPrint('🎤 Обнаружен голосовой ввод');
        final voiceText = ref.read(analysis.manualFoodInputProvider);
        if (voiceText.isNotEmpty) {
          // Устанавливаем текст в контроллер
          _dishNameController.text = voiceText;

          // Запускаем анализ по голосовому запросу с использованием унифицированного сервиса
          // Изображение будет получено в процессе анализа
          _analyzeInput(recognizedVoice: voiceText);
          return;
        }
      }

      // Получаем изображение, выбранное на предыдущем экране
      final selectedImage = ref.read(analysis.selectedImageProvider);
      if (selectedImage != null) {
        setState(() {
          _imageFile = selectedImage;
        });
        debugPrint(
            '🖼️ Изображение получено из провайдера: ${selectedImage.path}');
      } else {
        debugPrint('⚠️ Изображение отсутствует в провайдере.');
      }

      // Проверяем, есть ли сохраненные результаты анализа
      final savedResults = ref.read(analysis.lastAnalysisResultsProvider);

      if (savedResults != null && savedResults.info.dishName.isNotEmpty) {
        // Устанавливаем последнее известное имя блюда в контроллер
        setState(() {
          _dishNameController.text = savedResults.info.dishName;
        });
        debugPrint(
            '💾 Загружены сохраненные результаты для блюда: ${savedResults.info.dishName}');

        // Если изображение отсутствует, но у нас есть результаты анализа,
        // создаем программное изображение на основе результатов
        if (_imageFile == null && savedResults.info.dishName.isNotEmpty) {
          debugPrint(
              '🎨 Создаем программное изображение для: ${savedResults.info.dishName}');
          await _generateImageForDish(savedResults.info);
          // Не запускаем анализ, так как у нас уже есть результаты
          return;
        }
      }

      // Проверяем, нужен ли новый анализ
      final needsNewAnalysis = _isNewAnalysisSession();

      if (needsNewAnalysis && _imageFile != null) {
        debugPrint('🔄 Запуск нового анализа изображения');
        _analyzeInput(imageFile: _imageFile);
      } else {
        debugPrint(
            '⏸️ Нет необходимости в новом анализе: needsNewAnalysis=$needsNewAnalysis, изображение=${_imageFile != null}');
      }
    });
  }

  /// Универсальный метод для анализа всех типов ввода
  Future<void> _analyzeInput({
    String? text,
    String? recognizedVoice,
    File? imageFile,
  }) async {
    if (_isAnalysisInProgress) {
      debugPrint('⚠️ Анализ уже в процессе, игнорируем повторный вызов');
      return;
    }

    // Предотвращаем повторный анализ
    setState(() {
      _isAnalysisInProgress = true;
    });

    try {
      // Получаем унифицированный сервис анализа
      final unifiedService = ref.read(unifiedAnalysisServiceProvider);

      // Выполняем анализ с помощью подходящей стратегии
      final nutritionInfo = await unifiedService.analyze(
        context: context,
        text: text,
        recognizedVoice: recognizedVoice,
        imageFile: imageFile,
      );

      if (!mounted) return;

      // Проверяем, является ли запрос несъедобным объектом
      if (nutritionInfo.error != null && nutritionInfo.error!.isNotEmpty) {
        debugPrint(
            '⚠️ Анализ выявил несъедобный объект: ${nutritionInfo.error}');

        // Обновляем состояние с результатами, которые содержат сообщение об ошибке
        ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
            AsyncValue.data(nutritionInfo);

        // Сохраняем результаты для возможного восстановления
        ref.read(analysis.lastAnalysisResultsProvider.notifier).state =
            analysis.AnalysisResults(
          info: nutritionInfo,
          timestamp: DateTime.now(),
        );

        // Важно: НЕ пытаемся генерировать изображение для несъедобных объектов
        // Если это был текстовый запрос или голосовой ввод, очищаем текущее изображение
        if (imageFile == null) {
          setState(() {
            _imageFile = null;
          });
        }

        setState(() {
          _isAnalysisInProgress = false;
        });

        return;
      }

      // Проверяем, получены ли результаты
      bool isEmpty = nutritionInfo.dishName.isEmpty &&
          nutritionInfo.calories == 0 &&
          nutritionInfo.proteins == 0 &&
          nutritionInfo.fats == 0 &&
          nutritionInfo.carbs == 0;

      if (isEmpty) {
        // Если результаты пустые, показываем сообщение и возвращаемся на предыдущий экран
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              content: Text(
                  'Не удалось проанализировать блюдо. Попробуйте другой запрос.'),
              duration: Duration(seconds: 3),
            ),
          );

          // Если это был голосовой ввод, возвращаемся на предыдущий экран
          if (recognizedVoice != null && mounted) {
            // Используем централизованный провайдер для безопасной навигации
            ref.read(analysis.safeNavigationBackProvider)(context);
          }
        }
        return;
      }

      // Обновляем имя блюда в контроллере
      setState(() {
        _dishNameController.text = nutritionInfo.dishName;
      });

      // Если у nutritionInfo есть путь к изображению (для голосового ввода),
      // используем это изображение
      if (nutritionInfo.imagePath != null &&
          nutritionInfo.imagePath!.isNotEmpty) {
        final imageFromPath = File(nutritionInfo.imagePath!);
        if (await imageFromPath.exists()) {
          setState(() {
            _imageFile = imageFromPath;
          });

          // Сохраняем изображение в провайдере
          ref.read(analysis.selectedImageProvider.notifier).state = _imageFile;

          debugPrint(
              '🖼️ Установлено изображение из nutritionInfo: ${nutritionInfo.imagePath}');
        }
      }

      // Обновляем состояние с результатами
      ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
          AsyncValue.data(nutritionInfo);

      // Сохраняем результаты анализа для возможного восстановления
      ref.read(analysis.lastAnalysisResultsProvider.notifier).state =
          analysis.AnalysisResults(
        info: nutritionInfo,
        timestamp: DateTime.now(),
      );

      // Если изображение отсутствует и в nutritionInfo нет пути к изображению,
      // генерируем программное изображение - но только для съедобных объектов
      if (_imageFile == null &&
          (nutritionInfo.imagePath == null ||
              nutritionInfo.imagePath!.isEmpty) &&
          (nutritionInfo.error == null || nutritionInfo.error!.isEmpty)) {
        await _generateImageForDish(nutritionInfo);
      }
    } catch (e) {
      debugPrint('❌ Ошибка при анализе: $e');

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Произошла ошибка: ${e.toString()}'),
            duration: const Duration(seconds: 3),
          ),
        );
      }
    } finally {
      // Сбрасываем флаг анализа
      if (mounted) {
        setState(() {
          _isAnalysisInProgress = false;
        });
      }
    }
  }

  @override
  void dispose() {
    _dishNameController.dispose();

    // Скрываем экран загрузки при уничтожении экрана, если он был показан
    try {
      LoadingManager().hideLoadingScreen();
    } catch (e) {
      debugPrint('🎤 Ошибка при скрытии экрана загрузки в dispose: $e');
    }

    // Сбрасываем состояние анализа при выходе с экрана
    // Для всех типов ввода - и обычного, и голосового
    try {
      // Проверяем, что виджет все еще mounted перед использованием ref
      if (mounted) {
        // Только если провайдер доступен
        ref.read(analysis.resetAnalysisStateProvider)();
      }
    } catch (e) {
      debugPrint('🎤 Ошибка при сбросе состояния анализа при выходе: $e');
    }

    super.dispose();
  }

  void _checkApiKey() {
    setState(() {
      _isMockService = false;
    });
  }

  Future<void> _takePicture() async {
    try {
      debugPrint('📷 Запуск камеры для съемки...');
      final XFile? image = await _picker.pickImage(source: ImageSource.camera);

      if (image != null) {
        debugPrint('📷 Получено изображение с камеры: ${image.path}');

        // Сбрасываем предыдущие результаты анализа перед установкой нового изображения
        ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
            const AsyncValue.loading();

        // Обновляем состояние с новым изображением
        setState(() {
          _imageFile = File(image.path);
        });

        debugPrint(
            '📷 Состояние приложения обновлено с новым изображением: ${_imageFile!.path}');

        // Используем SchedulerBinding чтобы гарантировать, что экран загрузки показывается
        // после полного обновления UI и вне цикла рендеринга
        SchedulerBinding.instance.addPostFrameCallback((_) {
          if (!mounted) return;

          debugPrint(
              '📷 PostFrameCallback: Отображение экрана загрузки для анализа...');
          // Показываем экран загрузки через PostFrameCallback
          LoadingManager().showLoadingScreen(
            context,
            text: 'Анализ фотографии...',
            animationPath: 'assets/animations/road.json',
            animationHeight: MediaQuery.of(context).size.height * 0.4,
            backgroundColor: Colors.white,
            processingStepText: 'Подготовка фотографии к анализу',
            progressValue: 0.1,
          );

          // Используем еще один отложенный запуск для анализа изображения
          Future.delayed(const Duration(milliseconds: 500), () async {
            if (!mounted) return;

            debugPrint('📷 Начало процесса анализа изображения с камеры');

            // Устанавливаем состояние загрузки
            ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
                const AsyncValue.loading();

            try {
              debugPrint(
                  '📷 Начало анализа изображения с камеры через Vision и DeepSeek');
              debugPrint('📷 Путь к изображению: ${_imageFile!.path}');
              debugPrint(
                  '📷 Размер изображения: ${await _imageFile!.length()} байт');

              // Обновляем информацию о процессе - Cloud Vision
              LoadingManager().updateProcessingInfo(
                context,
                newText: 'Распознавание объектов на фотографии...',
                newProcessingStep:
                    'Отправка изображения в Google Vision API для распознавания объектов',
                newProgressValue: 0.25,
                animationPath: 'assets/animations/road.json',
                animationHeight: MediaQuery.of(context).size.height * 0.4,
              );

              // Даем время для обновления UI
              await Future.delayed(const Duration(milliseconds: 500));

              if (!mounted) return;
              debugPrint('📷 Экран загрузки обновлен для этапа Vision');

              // Получаем интегратор
              final integrator =
                  ref.read(services.visionDeepSeekIntegratorProvider);
              debugPrint('📷 Получен экземпляр интегратора');

              // Имитация получения данных от Google Vision
              await Future.delayed(const Duration(seconds: 2));

              if (!mounted) return;

              // Обновляем информацию о процессе - DeepSeek
              LoadingManager().updateProcessingInfo(
                context,
                newText: 'Анализ питательной ценности блюда...',
                newProcessingStep:
                    'Искусственный интеллект анализирует распознанные объекты',
                newProgressValue: 0.6,
                animationPath: 'assets/animations/road.json',
                animationHeight: MediaQuery.of(context).size.height * 0.4,
              );

              debugPrint('📷 Экран загрузки обновлен для этапа DeepSeek');

              // Анализируем изображение
              debugPrint('📷 Отправка изображения в Vision + DeepSeek API...');

              // Выполняем анализ напрямую (без отдельного потока)
              final nutritionInfo = await integrator
                  .analyzeImageWithVisionAndDeepSeek(_imageFile!);

              debugPrint(
                  '📷 Анализ завершен. Результат: ${nutritionInfo.dishName}');

              if (!mounted) return;

              // Проверяем, не вернулись ли пустые данные
              bool isEmpty = nutritionInfo.dishName.isEmpty &&
                  nutritionInfo.calories == 0 &&
                  nutritionInfo.proteins == 0 &&
                  nutritionInfo.fats == 0 &&
                  nutritionInfo.carbs == 0;

              if (isEmpty) {
                debugPrint('📷 Получены пустые данные анализа');

                // Обновляем информацию о процессе при ошибке
                LoadingManager().updateProcessingInfo(
                  context,
                  newText: 'Не удалось распознать блюдо',
                  newProcessingStep:
                      'К сожалению, ИИ не смог идентифицировать блюдо на фотографии',
                  newProgressValue: 1.0,
                  animationPath: 'assets/animations/road.json',
                  animationHeight: MediaQuery.of(context).size.height * 0.4,
                );

                // Вместо ошибки, обновляем состояние
                ref
                    .read(analysis.nutritionAnalysisStateProvider.notifier)
                    .state = AsyncValue.data(nutritionInfo);

                // Задержка перед скрытием экрана загрузки
                await Future.delayed(const Duration(seconds: 3));

                if (mounted) {
                  LoadingManager().hideLoadingScreen();
                  debugPrint('📷 Загрузочный экран скрыт после ошибки');
                }
              } else {
                // Обновляем информацию о процессе при успехе
                LoadingManager().updateProcessingInfo(
                  context,
                  newText: 'Анализ успешно завершен!',
                  newProcessingStep:
                      'Ваше блюдо "${nutritionInfo.dishName}" успешно проанализировано',
                  newProgressValue: 1.0,
                  animationPath: 'assets/animations/road.json',
                  animationHeight: MediaQuery.of(context).size.height * 0.4,
                );

                debugPrint('📷 Экран загрузки обновлен с результатами');

                // Обновляем состояние с результатами
                ref
                    .read(analysis.nutritionAnalysisStateProvider.notifier)
                    .state = AsyncValue.data(nutritionInfo);

                debugPrint('📷 Состояние обновлено с результатами анализа');

                // Небольшая задержка перед скрытием экрана загрузки
                await Future.delayed(const Duration(seconds: 2));

                if (mounted) {
                  LoadingManager().hideLoadingScreen();
                  debugPrint(
                      '📷 Загрузочный экран скрыт после успешного анализа');
                }
              }
            } catch (error) {
              debugPrint('📷 Ошибка при анализе: $error');

              if (!mounted) return;

              // Обновляем информацию о процессе при ошибке
              LoadingManager().updateProcessingInfo(
                context,
                newText: 'Ошибка при анализе фотографии',
                newProcessingStep:
                    'Произошла ошибка при обработке изображения: $error',
                newProgressValue: 1.0,
                animationPath: 'assets/animations/road.json',
                animationHeight: MediaQuery.of(context).size.height * 0.4,
              );

              // Возвращаем пустой объект
              final emptyInfo = NutritionInfo.empty();
              ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
                  AsyncValue.data(emptyInfo);

              // Задержка перед скрытием экрана загрузки
              await Future.delayed(const Duration(seconds: 3));

              if (mounted) {
                LoadingManager().hideLoadingScreen();
                debugPrint('📷 Загрузочный экран скрыт после ошибки');
              }
            }
          });
        });
      } else {
        debugPrint('📷 Выбор изображения с камеры отменен');
      }
    } catch (e) {
      debugPrint('📷 Ошибка при работе с камерой: $e');
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Ошибка при работе с камерой: $e')),
        );
      }
    }
  }

  /// Анализирует изображение в фоновом режиме и заполняет completer результатом
  void _analyzeImageInBackground(File imageFile, dynamic integrator,
      Completer<NutritionInfo> completer) async {
    try {
      debugPrint('🔄 Запуск анализа в фоновом режиме...');
      final nutritionInfo =
          await integrator.analyzeImageWithVisionAndDeepSeek(imageFile);
      debugPrint('🔄 Получен результат анализа: ${nutritionInfo.dishName}');
      completer.complete(nutritionInfo);
    } catch (e) {
      debugPrint('🔄 Ошибка при фоновом анализе: $e');
      completer.completeError(e);
    }
  }

  Future<void> _pickImage() async {
    // Получаем изображение из галереи
    final XFile? image = await _picker.pickImage(source: ImageSource.gallery);
    if (image != null) {
      // Сбрасываем предыдущие результаты анализа перед установкой нового изображения
      ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
          const AsyncValue.loading();

      // Обновляем состояние с новым изображением
      setState(() {
        _imageFile = File(image.path);
      });

      // Показываем экран загрузки перед началом анализа
      LoadingManager().showLoadingScreen(
        context,
        text: 'Анализ изображения...',
        animationPath: 'assets/animations/road.json',
        animationHeight: MediaQuery.of(context).size.height * 0.4,
        backgroundColor: Colors.white,
        processingStepText: 'Подготовка изображения из галереи для анализа',
        progressValue: 0.1,
      );

      // Даем немного времени для отображения экрана загрузки
      await Future.delayed(const Duration(milliseconds: 100));

      // Запускаем анализ изображения
      await _analyzeImage(skipLoadingScreen: true);
    }
  }

  Future<void> _saveMeal() async {
    if (_imageFile == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Нет изображения для сохранения')),
      );
      return;
    }

    final analysisState = ref.read(analysis.nutritionAnalysisStateProvider);

    if (analysisState is! AsyncData<NutritionInfo>) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Дождитесь окончания анализа')),
      );
      return;
    }

    final nutritionInfo = analysisState.value;

    if (nutritionInfo.dishName.isEmpty && nutritionInfo.calories == 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
            content:
                Text('Нет данных для сохранения. Анализ не дал результатов')),
      );
      return;
    }

    // Показываем экран загрузки с полным размером анимации и начальным этапом
    LoadingManager().showLoadingScreen(
      context,
      text: 'Сохранение блюда...',
      animationPath: 'assets/animations/road.json',
      animationHeight: MediaQuery.of(context).size.height * 0.4,
      backgroundColor: Colors.white,
      processingStepText: 'Подготовка данных о блюде для сохранения',
      progressValue: 0.1,
    );

    setState(() {
      _isSaving = true;
    });

    try {
      // Если в контроллере есть текст, используем его как название блюда
      final dishName = _dishNameController.text.isNotEmpty
          ? _dishNameController.text
          : nutritionInfo.dishName;

      // Преобразуем ингредиенты из модели NutritionInfo в IngredientModel
      final ingredients = nutritionInfo.ingredients
          .map((ingredient) => IngredientModel(
                name: ingredient.name,
                quantity: ingredient.weight,
              ))
          .toList();

      // Обновляем информацию о процессе сохранения
      LoadingManager().updateProcessingInfo(
        context,
        newText: 'Обработка данных о блюде...',
        newProcessingStep:
            'Обработка информации о блюде "$dishName" с ${ingredients.length} ингредиентами',
        newProgressValue: 0.25,
        animationPath: 'assets/animations/road.json',
        animationHeight: MediaQuery.of(context).size.height * 0.4,
      );

      // Создаем объект питательных веществ
      final nutrients = NutrientsModel(
        calories: nutritionInfo.calories.round(),
        proteins: nutritionInfo.proteins,
        fats: nutritionInfo.fats,
        carbs: nutritionInfo.carbs,
      );

      // Создаем объект приема пищи
      final meal = MealModel(
        id: const Uuid().v4(),
        name: dishName,
        dateTime: DateTime.now(),
        imagePath: _imageFile!.path,
        ingredients: ingredients,
        nutrients: nutrients,
      );

      // Обновляем информацию о процессе сохранения
      LoadingManager().updateProcessingInfo(
        context,
        newText: 'Сохранение данных...',
        newProcessingStep:
            'Сохранение блюда и его питательной ценности в базу данных приложения',
        newProgressValue: 0.5,
        animationPath: 'assets/animations/road.json',
        animationHeight: MediaQuery.of(context).size.height * 0.4,
      );

      // Сохраняем прием пищи в репозиторий
      final mealRepository = ref.read(home.mealRepositoryProvider);
      await mealRepository.saveMeal(meal);

      // Добавляем прием пищи в список дневных приемов пищи
      ref.read(home.dailyMealsProvider.notifier).addMeal(meal);

      // Обновляем информацию о процессе сохранения
      LoadingManager().updateProcessingInfo(
        context,
        newText: 'Обновление дневной статистики...',
        newProcessingStep: 'Обновление суммарной питательной ценности за день',
        newProgressValue: 0.75,
        animationPath: 'assets/animations/road.json',
        animationHeight: MediaQuery.of(context).size.height * 0.4,
      );

      // Обновляем суммарные нутриенты за день
      final dailyNutrients = ref.read(home.dailyNutrientsProvider);
      if (dailyNutrients != null) {
        final updatedNutrients = NutrientsModel(
          calories: dailyNutrients.calories + nutrients.calories,
          proteins: dailyNutrients.proteins + nutrients.proteins,
          fats: dailyNutrients.fats + nutrients.fats,
          carbs: dailyNutrients.carbs + nutrients.carbs,
        );
        ref
            .read(home.dailyNutrientsProvider.notifier)
            .setNutrients(updatedNutrients);
      }

      // Обновляем информацию о процессе сохранения
      LoadingManager().updateProcessingInfo(
        context,
        newText: 'Блюдо успешно сохранено!',
        newProcessingStep:
            'Блюдо "$dishName" добавлено в дневник питания. Питательная ценность обновлена.',
        newProgressValue: 0.9,
        animationPath: 'assets/animations/road.json',
        animationHeight: MediaQuery.of(context).size.height * 0.4,
      );

      // Подготовка перехода на домашний экран - используем специальный метод для перехода
      LoadingManager().showTransitionScreen(
        context,
        text: 'Возвращение на главный экран...',
        processingStepText: 'Подготовка перехода на главный экран',
      );

      // После успешного сохранения сбрасываем состояние анализа
      if (mounted) {
        // Сбрасываем состояние анализа ПЕРЕД навигацией
        ref.read(analysis.resetAnalysisStateProvider)();

        // Небольшая задержка для визуальной обратной связи
        debugPrint('✅ Ожидание короткой задержки с показом экрана перехода');
        await Future.delayed(const Duration(milliseconds: 300));

        // Выполняем безопасную навигацию на домашний экран, сохраняя экран загрузки активным
        debugPrint('✅ Выполняем навигацию с активным экраном загрузки');
        if (!mounted) return;

        // Показываем сообщение о сохранении, не скрывая экран загрузки
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Прием пищи сохранен')),
        );

        // Всегда переходим на домашний экран независимо от источника ввода
        Navigator.of(context)
            .pushNamedAndRemoveUntil('/home', (route) => false);
        debugPrint(
            '✅ Выполнена навигация на домашний экран, прерываем метод _saveMeal');
        return; // Важно: немедленно прерываем выполнение метода
      }
    } catch (e) {
      // Обновляем информацию о процессе при ошибке
      if (mounted) {
        LoadingManager().updateProcessingInfo(
          context,
          newText: 'Ошибка при сохранении блюда',
          newProcessingStep: 'Произошла ошибка при сохранении: $e',
          newProgressValue: 1.0,
          animationPath: 'assets/animations/road.json',
          animationHeight: MediaQuery.of(context).size.height * 0.4,
        );

        // Задержка перед скрытием экрана загрузки
        await Future.delayed(const Duration(seconds: 2));
        LoadingManager().hideLoadingScreen();

        // Показываем сообщение об ошибке
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Ошибка при сохранении блюда: $e')),
        );
      }
    } finally {
      // Завершение операции и обновление состояния
      if (mounted) {
        setState(() {
          _isSaving = false;
        });
      }
    }
  }

  /// Проверяет, является ли изображение новым для существующих результатов
  bool _isNewAnalysisSession() {
    // Проверяем, является ли просмотр просмотром истории
    final isHistoryView = ref.read(analysis.isHistoryViewProvider);
    if (isHistoryView) {
      debugPrint('🔍 Обнаружен просмотр истории, пропускаем анализ');
      return false;
    }

    // Получаем текущее изображение
    final selectedImage = _imageFile;

    // Если нет выбранного изображения, новый анализ не требуется
    if (selectedImage == null) {
      return false;
    }

    // Получаем текущее состояние анализа
    final analysisState = ref.read(analysis.nutritionAnalysisStateProvider);

    // Проверяем, используем ли мы изображение с префиксом food_home_
    // Это изображения, полученные из галереи или камеры - для них всегда делаем новый анализ
    if (selectedImage.path.contains('food_home_')) {
      // Проверяем, было ли последнее изображение из того же источника
      final selectedImageProvider = ref.read(analysis.selectedImageProvider);
      final lastAnalysisResults =
          ref.read(analysis.lastAnalysisResultsProvider);

      // Если есть предыдущие результаты анализа и они совпадают с текущим изображением
      if (lastAnalysisResults != null &&
          selectedImageProvider != null &&
          selectedImageProvider.path == selectedImage.path) {
        // Если это то же самое изображение, не делаем повторный анализ
        debugPrint(
            '🔍 Обнаружено то же изображение, что было проанализировано ранее: ${lastAnalysisResults.info.dishName}');
        return false;
      }

      // Для нового изображения с префиксом food_home_ всегда делаем новый анализ
      debugPrint(
          '🔍 Обнаружено новое изображение из домашнего экрана, запускаем новый анализ');
      return true;
    }

    // Проверяем, есть ли у нас действительные результаты анализа
    if (analysisState is AsyncData<NutritionInfo>) {
      bool hasValidResults = analysisState.value.dishName.isNotEmpty &&
          analysisState.value.calories > 0 &&
          (analysisState.value.proteins > 0 ||
              analysisState.value.fats > 0 ||
              analysisState.value.carbs > 0);

      // Если это программно созданное изображение (dish_), не запускаем повторный анализ
      if (selectedImage.path.contains('dish_') && hasValidResults) {
        debugPrint(
            '🔍 Обнаружено программное изображение, пропускаем повторный анализ');
        return false;
      }
    }

    // По умолчанию считаем, что нужен новый анализ
    return true;
  }

  @override
  Widget build(BuildContext context) {
    // Получаем состояние анализа питательной ценности
    final analysisState = ref.watch(analysis.nutritionAnalysisStateProvider);

    // Используем WillPopScope для контроля выхода с экрана
    return WillPopScope(
      // Предотвращаем черный экран при возврате
      onWillPop: () async {
        // Показываем специальный экран перехода перед навигацией
        LoadingManager().showTransitionScreen(
          context,
          text: 'Возвращение на главный экран...',
          processingStepText: 'Подготовка перехода на главный экран',
        );

        // Сбрасываем состояние анализа ПЕРЕД навигацией
        ref.read(analysis.resetAnalysisStateProvider)();

        // Небольшая задержка для полной отрисовки экрана перехода
        await Future.delayed(const Duration(milliseconds: 100));

        // Используем централизованный провайдер для безопасной навигации
        if (mounted) {
          if (widget.isVoiceInput) {
            // Для голосового ввода используем явную навигацию на домашний экран вместо pop
            Navigator.of(context)
                .pushNamedAndRemoveUntil('/home', (route) => false);
            debugPrint('🧭 Выполнена навигация на домашний экран из onWillPop');
            return false; // Важно: немедленно прерываем выполнение метода
          } else {
            // Для других типов ввода используем провайдер безопасной навигации
            ref.read(analysis.safeNavigationBackProvider)(context);
            debugPrint(
                '🧭 Выполнена навигация через safeNavigationBackProvider из onWillPop');
            return false; // Важно: немедленно прерываем выполнение метода
          }
        }

        // Возвращаем false, так как мы уже обработали навигацию
        return false;
      },
      child: Scaffold(
        extendBodyBehindAppBar: true,
        appBar: PreferredSize(
          preferredSize: const Size.fromHeight(0), // Скрываем AppBar полностью
          child: AppBar(
            backgroundColor: Colors.transparent,
            elevation: 0,
          ),
        ),
        body: Stack(
          children: [
            // Основной контент в SingleChildScrollView
            SingleChildScrollView(
              child: Column(
                children: [
                  // Область изображения
                  _buildImageSection(),

                  // Информация о еде
                  analysisState.when(
                    data: (nutritionInfo) {
                      // Если блюдо успешно проанализировано, показываем информацию о нём
                      return _buildAnalysisResults(nutritionInfo);
                    },
                    loading: () => const Center(
                      child: Padding(
                        padding: EdgeInsets.all(32.0),
                        child: Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            CircularProgressIndicator(),
                            SizedBox(height: 16),
                            Text('Анализ изображения...'),
                          ],
                        ),
                      ),
                    ),
                    error: (e, _) => Center(
                      child: Padding(
                        padding: const EdgeInsets.all(32.0),
                        child: Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Icon(
                              Icons.error_outline,
                              color: Colors.red,
                              size: 48,
                            ),
                            SizedBox(height: 16),
                            Text(
                              'Ошибка при анализе: $e',
                              textAlign: TextAlign.center,
                            ),
                            SizedBox(height: 16),
                            ElevatedButton(
                              onPressed: _analyzeImage,
                              child: Text('Повторить'),
                            ),
                          ],
                        ),
                      ),
                    ),
                  ),

                  // Добавляем отступ внизу для кнопок
                  SizedBox(height: 80),
                ],
              ),
            ),

            // Кнопка назад в левом верхнем углу
            Positioned(
              top: MediaQuery.of(context).padding.top + 8,
              left: 16,
              child: Container(
                decoration: BoxDecoration(
                  color: Colors.black.withOpacity(0.3),
                  shape: BoxShape.circle,
                ),
                child: IconButton(
                  icon: const Icon(Icons.arrow_back, color: Colors.white),
                  onPressed: () {
                    // Показываем специальный экран перехода перед навигацией
                    LoadingManager().showTransitionScreen(
                      context,
                      text: 'Возвращение на главный экран...',
                      processingStepText:
                          'Подготовка перехода на главный экран',
                    );

                    // Сбрасываем состояние анализа ПЕРЕД навигацией
                    ref.read(analysis.resetAnalysisStateProvider)();

                    // Используем централизованный провайдер для безопасной навигации
                    if (widget.isVoiceInput) {
                      // Для голосового ввода используем явную навигацию на домашний экран вместо pop
                      Navigator.of(context)
                          .pushNamedAndRemoveUntil('/home', (route) => false);
                      debugPrint(
                          '🧭 Выполнена навигация на домашний экран из кнопки назад');
                      return;
                    } else {
                      // Для других типов ввода используем провайдер безопасной навигации
                      ref.read(analysis.safeNavigationBackProvider)(context);
                      debugPrint(
                          '🧭 Выполнена навигация через safeNavigationBackProvider из кнопки назад');
                      return;
                    }
                  },
                ),
              ),
            ),

            // Нижняя панель с кнопками
            Positioned(
              bottom: 0,
              left: 0,
              right: 0,
              child: _buildBottomButtonsPanel(),
            ),
          ],
        ),
      ),
    );
  }

  // Метод для отображения BottomSheet для редактирования результата
  void _showEditResultBottomSheet() {
    final analysisState = ref.read(analysis.nutritionAnalysisStateProvider);

    if (analysisState is! AsyncData<NutritionInfo>) return;

    final nutritionInfo = analysisState.value;

    TextEditingBottomSheet.show(
      context: context,
      initialText: nutritionInfo.dishName,
      title: 'Изменить название блюда',
      hintText: 'Введите название блюда',
      onSave: (newName) async {
        if (newName.isEmpty) return;

        // Если название изменилось, проводим новый анализ
        if (newName != nutritionInfo.dishName) {
          // Обновляем текстовый контроллер
          setState(() {
            _dishNameController.text = newName;
          });

          // Запускаем новый анализ блюда по названию
          if (mounted) {
            // Показываем экран загрузки
            LoadingManager().showLoadingScreen(
              context,
              text: 'Обновление данных...',
              animationPath: 'assets/animations/road.json',
              animationHeight: MediaQuery.of(context).size.height * 0.4,
              backgroundColor: Colors.white,
              processingStepText: 'Анализ блюда по новому названию',
              progressValue: 0.1,
            );

            // Небольшая задержка для обновления UI
            await Future.delayed(const Duration(milliseconds: 200));

            // Проводим анализ по новому названию
            try {
              debugPrint(
                  '🔄 Запуск нового анализа после изменения названия: $newName');

              // Получаем сервис DeepSeek
              final nutritionService =
                  ref.read(services.deepSeekNutritionServiceProvider);

              // Обновляем информацию о процессе
              LoadingManager().updateProcessingInfo(
                context,
                newText: 'Получение данных о питательной ценности...',
                newProcessingStep:
                    'Анализ блюда "$newName" с помощью искусственного интеллекта',
                newProgressValue: 0.4,
                animationPath: 'assets/animations/road.json',
                animationHeight: MediaQuery.of(context).size.height * 0.4,
              );

              // Устанавливаем флаг анализа в процессе, чтобы предотвратить повторный анализ
              setState(() {
                _isAnalysisInProgress = true;
              });

              // Отправляем запрос к DeepSeek для анализа
              final updatedInfo =
                  await nutritionService.analyzeDishByName(newName);

              debugPrint('✅ Новый анализ завершен после изменения названия');
              debugPrint('✅ Результат: ${updatedInfo.dishName}');

              // Обновляем состояние с результатами
              ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
                  AsyncValue.data(updatedInfo);

              // Сохраняем результаты для восстановления при необходимости
              ref.read(analysis.lastAnalysisResultsProvider.notifier).state =
                  analysis.AnalysisResults(
                info: updatedInfo,
                timestamp: DateTime.now(),
              );
              // Обновляем информацию о процессе
              LoadingManager().updateProcessingInfo(
                context,
                newText: 'Анализ успешно завершен!',
                newProcessingStep: 'Обновлена информация о блюде "$newName"',
                newProgressValue: 1.0,
                animationPath: 'assets/animations/road.json',
                animationHeight: MediaQuery.of(context).size.height * 0.4,
              );

              // Короткая задержка перед скрытием экрана загрузки
              await Future.delayed(const Duration(seconds: 1));

              // Скрываем экран загрузки
              if (mounted) {
                LoadingManager().hideLoadingScreen();
              }
            } catch (error) {
              debugPrint(
                  '❌ Ошибка при анализе после изменения названия: $error');

              // Показываем сообщение об ошибке в экране загрузки
              LoadingManager().updateProcessingInfo(
                context,
                newText: 'Ошибка при анализе',
                newProcessingStep:
                    'Произошла ошибка при обновлении информации о блюде. Данные сохранены с новым названием, но без обновления питательной ценности.',
                newProgressValue: 1.0,
                animationPath: 'assets/animations/road.json',
                animationHeight: MediaQuery.of(context).size.height * 0.4,
              );

              // Создаем обновленную информацию только с новым названием
              final simpleUpdatedInfo =
                  nutritionInfo.copyWith(dishName: newName);

              // Обновляем состояние хотя бы с новым названием
              ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
                  AsyncValue.data(simpleUpdatedInfo);

              // Сохраняем результаты
              ref.read(analysis.lastAnalysisResultsProvider.notifier).state =
                  analysis.AnalysisResults(
                info: simpleUpdatedInfo,
                timestamp: DateTime.now(),
              );

              // Задержка перед скрытием экрана загрузки
              await Future.delayed(const Duration(seconds: 2));

              // Скрываем экран загрузки
              if (mounted) {
                LoadingManager().hideLoadingScreen();

                // Уведомляем пользователя об ошибке
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                      content: Text(
                          'Название изменено, но произошла ошибка при обновлении данных: $error')),
                );
              }
            } finally {
              // Сбрасываем флаг анализа в процессе
              if (mounted) {
                setState(() {
                  _isAnalysisInProgress = false;
                });
              }
            }
          }
        } else {
          // Если название не изменилось, просто сохраняем текущее состояние
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(content: Text('Название блюда не было изменено')),
          );
        }
      },
    );
  }

  Widget _buildAnalysisResults(NutritionInfo info) {
    // Проверяем наличие сообщения об ошибке (не еда)
    if (info.error != null && info.error!.isNotEmpty) {
      return Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              "Не пищевой продукт",
              style: TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
                color: Colors.red,
              ),
            ),
            const SizedBox(height: 12),
            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: Colors.red[50],
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: Colors.red.shade300),
              ),
              child: Row(
                children: [
                  Icon(Icons.error_outline, color: Colors.red[700]),
                  const SizedBox(width: 8),
                  Expanded(
                    child: Text(
                      info.error!,
                      style: TextStyle(color: Colors.red[700]),
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      );
    }

    // Проверяем, не являются ли все значения нулевыми - это признак ошибки распознавания
    bool isEmptyAnalysis = info.calories == 0 &&
        info.proteins == 0 &&
        info.fats == 0 &&
        info.carbs == 0 &&
        info.ingredients.isEmpty;

    return Padding(
      padding: const EdgeInsets.all(16.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Название блюда
          Text(
            isEmptyAnalysis ? "Пища не распознана" : info.dishName,
            style: const TextStyle(
              fontSize: 24,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 12),

          if (isEmptyAnalysis)
            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: Colors.red[50],
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: Colors.red.shade300),
              ),
              child: Row(
                children: [
                  Icon(Icons.error_outline, color: Colors.red[700]),
                  const SizedBox(width: 8),
                  Expanded(
                    child: Text(
                      'Распознавание не удалось. Убедитесь, что на изображении четко видно блюдо, и попробуйте еще раз.',
                      style: TextStyle(color: Colors.red[700]),
                    ),
                  ),
                ],
              ),
            )
          else
            Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                // Нутриционная карточка с закругленными углами
                Container(
                  padding: const EdgeInsets.all(16),
                  decoration: BoxDecoration(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(16),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.grey.withOpacity(0.2),
                        blurRadius: 10,
                        spreadRadius: 1,
                      ),
                    ],
                  ),
                  child: Column(
                    children: [
                      Row(
                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                        children: [
                          _buildNutrientItem(
                              "Калории",
                              "${info.calories.toStringAsFixed(1)} ккал",
                              Colors.red),
                          _buildNutrientItem(
                              "Белки",
                              "${info.proteins.toStringAsFixed(1)} г",
                              Colors.green),
                          _buildNutrientItem(
                              "Жиры",
                              "${info.fats.toStringAsFixed(1)} г",
                              Colors.yellow.shade800),
                          _buildNutrientItem(
                              "Углеводы",
                              "${info.carbs.toStringAsFixed(1)} г",
                              Colors.purple),
                        ],
                      ),
                      if (info.ingredients.isNotEmpty) ...[
                        //const Divider(),
                        const SizedBox(height: 15),
                        const Text(
                          "Ингредиенты:",
                          style: TextStyle(
                            fontSize: 15,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        // Небольшой отступ после заголовка
                        const SizedBox(height: 8),
                        ListView.builder(
                          padding: EdgeInsets.zero,
                          shrinkWrap: true,
                          physics: const NeverScrollableScrollPhysics(),
                          itemCount: info.ingredients.length,
                          itemBuilder: (context, index) {
                            final ingredient = info.ingredients[index];
                            return Padding(
                              padding:
                                  const EdgeInsets.symmetric(vertical: 3.0),
                              child: Row(
                                mainAxisAlignment:
                                    MainAxisAlignment.spaceBetween,
                                children: [
                                  Expanded(
                                    child: Text(
                                      ingredient.name,
                                      style: const TextStyle(fontSize: 14),
                                      overflow: TextOverflow.ellipsis,
                                    ),
                                  ),
                                  const SizedBox(width: 8),
                                  Text(
                                    "${ingredient.weight.toStringAsFixed(1)} г",
                                    style: TextStyle(
                                      color: Colors.grey[600],
                                      fontWeight: FontWeight.bold,
                                    ),
                                  ),
                                ],
                              ),
                            );
                          },
                        ),
                      ],
                    ],
                  ),
                ),

                // Добавляем больше отступа внизу для удобства
                //const SizedBox(height: 32),
              ],
            ),
        ],
      ),
    );
  }

  Widget _buildNutrientItem(String label, String value, Color color) {
    return Column(
      children: [
        Container(
          padding: const EdgeInsets.all(8),
          decoration: BoxDecoration(
            color: color.withAlpha(50),
            shape: BoxShape.circle,
          ),
          child: Icon(
            Icons.pie_chart,
            color: color,
            size: 20,
          ),
        ),
        const SizedBox(height: 4),
        Text(
          value,
          style: const TextStyle(
            fontSize: 16,
            fontWeight: FontWeight.bold,
          ),
          overflow: TextOverflow.ellipsis,
        ),
        Text(
          label,
          style: TextStyle(
            fontSize: 12,
            color: Colors.grey[600],
          ),
        ),
      ],
    );
  }

  // Метод для отображения изображения блюда
  Widget _buildImageSection() {
    return _imageFile != null
        ? Container(
            width: double.infinity,
            height: MediaQuery.of(context).size.height *
                0.4, // 40% от высоты экрана
            decoration: BoxDecoration(
              borderRadius: const BorderRadius.only(
                bottomLeft: Radius.circular(20),
                bottomRight: Radius.circular(20),
              ),
              boxShadow: [
                BoxShadow(
                  color: Colors.black.withOpacity(0.1),
                  spreadRadius: 1,
                  blurRadius: 5,
                  offset: const Offset(0, 3),
                ),
              ],
            ),
            child: ClipRRect(
              borderRadius: const BorderRadius.only(
                bottomLeft: Radius.circular(20),
                bottomRight: Radius.circular(20),
              ),
              child: Image.file(
                _imageFile!,
                fit: BoxFit.cover,
              ),
            ),
          )
        : Container(
            width: double.infinity,
            height: MediaQuery.of(context).size.height *
                0.3, // 30% для пустого контейнера
            color: Colors.grey[200],
            child: const Center(
              child: Text('Выберите или сделайте фото блюда'),
            ),
          );
  }

  // Нижняя панель с кнопками "Сохранить" и "Изменить результат"
  Widget _buildBottomButtonsPanel() {
    final analysisState = ref.watch(analysis.nutritionAnalysisStateProvider);
    final isHistoryView = ref.watch(analysis.isHistoryViewProvider);

    // Не показываем панель, если это просмотр из истории
    if (isHistoryView) return const SizedBox.shrink();

    final hasValidResults = analysisState is AsyncData<NutritionInfo> &&
        !analysisState.hasError &&
        analysisState.value.dishName.isNotEmpty;

    // Проверяем, нет ли сообщения об ошибке "не еда"
    final hasErrorMessage = analysisState is AsyncData<NutritionInfo> &&
        analysisState.value.error != null &&
        analysisState.value.error!.isNotEmpty;

    if (!hasValidResults || hasErrorMessage) return const SizedBox.shrink();

    return Container(
      padding: const EdgeInsets.all(16.0),
      decoration: BoxDecoration(
        color: Colors.white,
        boxShadow: [
          BoxShadow(
            color: Colors.grey.withOpacity(0.2),
            spreadRadius: 1,
            blurRadius: 5,
            offset: const Offset(0, -1),
          ),
        ],
      ),
      child: Row(
        children: [
          // Кнопка "Изменить результат"
          Expanded(
            flex: 1,
            child: ElevatedButton.icon(
              onPressed: _showEditResultBottomSheet,
              icon: const Icon(
                Icons.edit,
                color: Colors.white,
              ),
              label: const Text(
                'Изменить',
                style: TextStyle(fontSize: 16, color: Colors.white),
              ),
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.blue,
                padding: const EdgeInsets.symmetric(vertical: 12),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(8),
                ),
              ),
            ),
          ),
          const SizedBox(width: 8),
          // Кнопка "Сохранить"
          Expanded(
            flex: 2,
            child: ElevatedButton.icon(
              onPressed: _isSaving ? null : _saveMeal,
              icon: Icon(
                Icons.save,
                color: Colors.white,
              ),
              label: Text(
                _isSaving ? 'Сохранение...' : 'Сохранить',
                style: TextStyle(fontSize: 16, color: Colors.white),
              ),
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.green,
                padding: const EdgeInsets.symmetric(vertical: 12),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(8),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  /// Безопасно сбрасывает состояние анализа с проверкой mounted
  void _safeResetAnalysisState() {
    // Проверяем, что виджет все еще смонтирован
    if (!mounted) {
      debugPrint('⚠️ Попытка сбросить состояние анализа после dispose виджета');
      return;
    }

    // Скрываем экран загрузки, если он отображается
    LoadingManager().hideLoadingScreen();

    // Сбрасываем состояние анализа в начальное значение
    ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
        AsyncValue.data(NutritionInfo.empty());

    // Очищаем последние результаты анализа
    ref.read(analysis.lastAnalysisResultsProvider.notifier).state = null;

    debugPrint('🔄 Безопасный сброс состояния анализа выполнен');
  }

  /// Генерирует изображение для блюда на основе его названия и типа
  Future<void> _generateImageForDish(NutritionInfo info) async {
    try {
      debugPrint('🎨 Создание изображения для блюда: ${info.dishName}');

      // Получаем директорию для временных файлов
      final tempDir = await getApplicationDocumentsDirectory();
      final String sanitizedName = info.dishName
          .toLowerCase()
          .replaceAll(RegExp(r'[^а-яёa-z0-9]'), '_')
          .replaceAll(RegExp(r'_+'), '_');
      final fileName =
          'dish_${sanitizedName}_${DateTime.now().millisecondsSinceEpoch}.png';
      final filePath = path.join(tempDir.path, fileName);

      // Создаем изображение с градиентным фоном и текстом
      final recorder = PictureRecorder();
      final canvas = Canvas(recorder);
      const size = Size(400, 300);

      // Рисуем градиентный фон
      final Rect rect = Rect.fromLTWH(0, 0, size.width, size.height);
      final gradient = LinearGradient(
        begin: Alignment.topLeft,
        end: Alignment.bottomRight,
        colors: [
          Colors.blue.shade100,
          Colors.green.shade100,
        ],
      );
      final paint = Paint()..shader = gradient.createShader(rect);
      canvas.drawRect(rect, paint);

      // Добавляем декоративный элемент (круг)
      final circlePaint = Paint()
        ..color = Colors.white.withOpacity(0.2)
        ..style = PaintingStyle.fill;
      canvas.drawCircle(Offset(size.width * 0.8, size.height * 0.2),
          size.width * 0.15, circlePaint);

      // Рисуем текст блюда с тенью
      final textPainter = TextPainter(
        text: TextSpan(
          text: info.dishName,
          style: TextStyle(
            color: Colors.grey.shade800,
            fontSize: 32,
            fontWeight: FontWeight.bold,
            shadows: [
              Shadow(
                color: Colors.black.withOpacity(0.3),
                offset: const Offset(2, 2),
                blurRadius: 3,
              ),
            ],
          ),
        ),
        textDirection: TextDirection.ltr,
        textAlign: TextAlign.center,
      );
      textPainter.layout(maxWidth: size.width - 40);
      textPainter.paint(
        canvas,
        Offset(
          (size.width - textPainter.width) / 2,
          (size.height - textPainter.height) / 2,
        ),
      );

      // Получаем изображение из рекордера
      final picture = recorder.endRecording();
      final img =
          await picture.toImage(size.width.toInt(), size.height.toInt());
      final byteData = await img.toByteData(format: ImageByteFormat.png);

      if (byteData == null) {
        debugPrint('❌ Не удалось создать данные изображения');
        return;
      }

      // Записываем созданное изображение в файл
      final imageFile = File(filePath);
      await imageFile.parent.create(recursive: true);
      await imageFile.writeAsBytes(
          byteData.buffer
              .asUint8List(byteData.offsetInBytes, byteData.lengthInBytes),
          flush: true);

      debugPrint('✅ Создано программное изображение блюда: $filePath');

      // Устанавливаем созданное изображение
      setState(() {
        _imageFile = imageFile;
      });

      // Сохраняем изображение в провайдере
      ref.read(analysis.selectedImageProvider.notifier).state = _imageFile;
    } catch (e) {
      debugPrint('❌ Ошибка при создании изображения для блюда: $e');
    }
  }

  /// Анализирует текущее выбранное изображение
  Future<void> _analyzeImage({bool skipLoadingScreen = false}) async {
    if (_imageFile == null) {
      debugPrint('⚠️ Нет изображения для анализа!');
      return;
    }

    try {
      // Получаем интегратор Vision + DeepSeek
      final integrator = ref.read(services.visionDeepSeekIntegratorProvider);

      // Показываем экран загрузки для пользователя
      setState(() {
        _isLoading = true;
      });

      // Обновляем состояние анализа
      ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
          const AsyncValue.loading();

      // Запускаем анализ в основном потоке
      debugPrint(
          '🔍 Начинаем анализ изображения: ${_imageFile!.path}. Режим: основной поток');

      // Метка для группировки логов анализа
      final analysisId = DateTime.now().millisecondsSinceEpoch;
      debugPrint('🔍 ANALYSIS_ID: $analysisId');

      try {
        // Показываем экран загрузки
        LoadingManager().showLoadingScreen(
          context,
          text: 'Идентификация объектов на изображении...',
          animationPath: 'assets/animations/road.json',
          backgroundColor: Colors.white,
          processingStepText:
              'Анализ изображения с помощью компьютерного зрения для распознавания блюда и ингредиентов',
          progressValue: 0.25,
          animationHeight: MediaQuery.of(context).size.height * 0.4,
        );

        debugPrint('🔍 Обновлен экран загрузки для этапа Google Vision');

        // Имитация получения данных от Google Vision
        await Future.delayed(const Duration(seconds: 2));

        if (!mounted) return;

        // Обновляем информацию о процессе - DeepSeek
        LoadingManager().updateProcessingInfo(
          context,
          newText: 'Анализ питательной ценности блюда...',
          newProcessingStep:
              'Искусственный интеллект анализирует распознанные объекты',
          newProgressValue: 0.6,
          animationPath: 'assets/animations/road.json',
          animationHeight: MediaQuery.of(context).size.height * 0.4,
        );

        debugPrint('📷 Экран загрузки обновлен для этапа DeepSeek');

        // Анализируем изображение
        debugPrint('📷 Отправка изображения в Vision + DeepSeek API...');

        // Выполняем анализ напрямую (без отдельного потока)
        final nutritionInfo =
            await integrator.analyzeImageWithVisionAndDeepSeek(_imageFile!);

        debugPrint('📷 Анализ завершен. Результат: ${nutritionInfo.dishName}');

        if (!mounted) return;

        // Проверяем, не вернулись ли пустые данные
        bool isEmpty = nutritionInfo.dishName.isEmpty &&
            nutritionInfo.calories == 0 &&
            nutritionInfo.proteins == 0 &&
            nutritionInfo.fats == 0 &&
            nutritionInfo.carbs == 0;

        if (isEmpty) {
          debugPrint('⚠️ Анализ вернул пустые данные');

          // Скрываем экран загрузки
          LoadingManager().hideLoadingScreen();

          // Показываем пользователю диалог о том, что на изображении не обнаружена еда
          _showNotFoodDialog();

          // Обновляем состояние
          setState(() {
            _isLoading = false;
          });

          // Обновляем состояние анализа на ошибку
          ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
              AsyncValue.error('Не удалось распознать еду на изображении',
                  StackTrace.current);

          return;
        }

        // Обновляем состояние
        ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
            AsyncValue.data(nutritionInfo);

        // Скрываем экран загрузки
        LoadingManager().hideLoadingScreen();

        // Обновляем UI
        setState(() {
          _isLoading = false;
          _analysisCompleted = true;
        });

        debugPrint('✅ Анализ успешно завершен и UI обновлен');
      } catch (e, stack) {
        if (!mounted) return;

        debugPrint('❌ Ошибка при анализе изображения: $e');
        debugPrint('❌ Stack trace: $stack');

        // Скрываем экран загрузки
        LoadingManager().hideLoadingScreen();

        // Обновляем состояние на ошибку
        ref.read(analysis.nutritionAnalysisStateProvider.notifier).state =
            AsyncValue.error(e, stack);

        // Обновляем UI
        setState(() {
          _isLoading = false;
        });

        // Показываем сообщение об ошибке
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Ошибка при анализе: ${e.toString()}'),
            backgroundColor: Colors.red,
          ),
        );
      }
    } catch (e) {
      debugPrint('❌ Неожиданная ошибка: $e');
      if (mounted) {
        // Скрываем экран загрузки
        LoadingManager().hideLoadingScreen();

        // Обновляем UI
        setState(() {
          _isLoading = false;
        });

        // Показываем сообщение об ошибке
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Произошла ошибка: ${e.toString()}'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  // Показывает диалог, если еда не обнаружена на изображении
  void _showNotFoodDialog() {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Еда не распознана'),
        content: const Text(
            'На изображении не обнаружена еда. Возможно, вы загрузили изображение, которое не содержит пищевых продуктов. Пожалуйста, попробуйте другое изображение.'),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Закрыть'),
          ),
        ],
      ),
    );
  }
}
