import 'dart:math' as math;
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:intl/date_symbol_data_local.dart';

import '../../models/meal_model.dart';
import '../../models/user_model.dart';
import '../home/home_providers.dart' as home;
import '../history/history_screen.dart';
import '../home/home_screen.dart';
import 'analytics_providers.dart' as analytics;
import '../../widgets/week_selector_header.dart';
import '../../services/providers.dart' as services;
import '../share/share_screen_manager.dart';
import '../share/share_provider.dart';
import '../../widgets/screenshot_container.dart';

class AnalyticsScreen extends ConsumerStatefulWidget {
  const AnalyticsScreen({super.key});

  @override
  ConsumerState<AnalyticsScreen> createState() => _AnalyticsScreenState();
}

class _AnalyticsScreenState extends ConsumerState<AnalyticsScreen> {
  final List<String> _weekDaysRu = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
  late DateTime _selectedDate;
  late DateTime _startOfWeek;
  late DateTime _endOfWeek;

  @override
  void initState() {
    super.initState();
    // Инициализируем локализацию для русского языка
    initializeDateFormatting('ru', null);
    _selectedDate = ref.read(analytics.selectedDateProvider);
    _updateWeekRange();
  }

  void _updateWeekRange() {
    // Вычисляем первый день недели (понедельник)
    final weekday = _selectedDate.weekday;
    _startOfWeek = _selectedDate.subtract(Duration(days: weekday - 1));
    // Последний день недели (воскресенье)
    _endOfWeek = _startOfWeek.add(const Duration(days: 6));
  }

  @override
  Widget build(BuildContext context) {
    final user = ref.watch(home.currentUserProvider);
    final dailyNutrientsAsync =
        ref.watch(analytics.dailyNutrientsForDateProvider(_selectedDate));
    final weeklyNutrientsAsync = ref.watch(analytics.weeklyNutrientsProvider);

    // Получаем менеджер скриншотов
    final shareManager = ref.read(shareScreenManagerProvider(ref));
    final screenshotKey = shareManager.getKeyForType(ScreenshotType.analytics);

    return Scaffold(
      backgroundColor: Colors.white,
      body: SafeArea(
        child: RefreshIndicator(
          onRefresh: () async {
            // Инвалидируем кэши при обновлении страницы
            ref.invalidate(analytics.weeklyNutrientsProvider);
            ref.invalidate(
                analytics.dailyNutrientsForDateProvider(_selectedDate));
          },
          child: CustomScrollView(
            slivers: [
              // Шапка с логотипом и селектором даты
              SliverToBoxAdapter(
                child: ScreenshotContainer(
                  boundaryKey: screenshotKey,
                  child: Column(
                    children: [
                      // Добавляем отступ сверху
                      const SizedBox(height: 16),
                      WeekSelectorHeader(
                        showLogo: true,
                        initialDate: _selectedDate,
                        onWeekSelected: (startDate, endDate) {
                          setState(() {
                            _selectedDate = startDate;
                            _startOfWeek = startDate;
                            _endOfWeek = endDate;
                          });
                          // Обновляем данные при смене недели
                          ref.invalidate(analytics.weeklyNutrientsProvider);
                          ref.invalidate(analytics
                              .dailyNutrientsForDateProvider(_selectedDate));
                        },
                      ),

                      // Отступ после календаря
                      const SizedBox(height: 12),

                      // Показываем данные об аналитике
                      dailyNutrientsAsync.when(
                        data: (dailyNutrients) {
                          return Padding(
                            padding:
                                const EdgeInsets.symmetric(horizontal: 0.0),
                            child: Column(
                              children: [
                                // Блок Калории
                                _buildCaloriesCard(
                                  user,
                                  dailyNutrients,
                                  weeklyNutrientsAsync,
                                ),
                                // Блок Нутриенты
                                _buildNutrientsCard(
                                  user,
                                  dailyNutrients,
                                  weeklyNutrientsAsync,
                                ),
                              ],
                            ),
                          );
                        },
                        loading: () => const Center(
                          child: Padding(
                            padding: EdgeInsets.all(32.0),
                            child: CircularProgressIndicator(),
                          ),
                        ),
                        error: (error, stack) => Center(
                          child: Padding(
                            padding: const EdgeInsets.all(32.0),
                            child: Text('Ошибка загрузки данных: $error'),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),

              // Дополнительный контент, не входящий в скриншот
              SliverToBoxAdapter(
                child: SizedBox(height: 80),
              ),
            ],
          ),
        ),
      ),
      bottomNavigationBar: _buildBottomNavigationBar(),
      floatingActionButton: _buildAddButton(),
      floatingActionButtonLocation: FloatingActionButtonLocation.centerDocked,
    );
  }

  Widget _buildBottomNavigationBar() {
    // Определяем цвет активной иконки и неактивных иконок
    final Color activeColor = Colors.blue;
    final Color inactiveColor = Colors.grey;

    return BottomAppBar(
      shape: const CircularNotchedRectangle(),
      notchMargin: 8,
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceAround,
        children: [
          IconButton(
            icon: Icon(Icons.home, color: inactiveColor),
            onPressed: () {
              Navigator.of(context).pushReplacement(
                MaterialPageRoute(builder: (context) => const HomeScreen()),
              );
            },
          ),
          IconButton(
            icon: Icon(Icons.history, color: inactiveColor),
            onPressed: () {
              Navigator.of(context).pushReplacement(
                MaterialPageRoute(
                  builder: (context) => const HistoryScreen(),
                ),
              );
            },
          ),
          const SizedBox(width: 40), // Место для FAB
          IconButton(
            icon: Icon(Icons.bar_chart, color: activeColor),
            onPressed: () {
              // Уже на экране аналитики
            },
          ),
          IconButton(
            icon: Icon(Icons.share, color: inactiveColor),
            onPressed: () {
              _shareScreenshot();
            },
          ),
        ],
      ),
    );
  }

  Future<void> _shareScreenshot() async {
    try {
      // Получаем менеджер скриншотов
      final shareManager = ref.read(shareScreenManagerProvider(ref));

      // Делимся скриншотом экрана аналитики
      await shareManager.shareScreenshot(ScreenshotType.analytics);
    } catch (e) {
      debugPrint('❌ Ошибка при создании или отправке скриншота: $e');
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Не удалось поделиться скриншотом')),
        );
      }
    }
  }

  Widget _buildAddButton() {
    return FloatingActionButton(
      child: const Icon(Icons.add),
      onPressed: () {
        // Используем общий сервис для добавления еды
        final foodInputService =
            ref.read(services.foodInputServiceProvider)(ref, context);
        foodInputService.showAddFoodOptions(onFoodAdded: () {
          // Обновляем данные после добавления еды
          ref.invalidate(analytics.weeklyNutrientsProvider);
          ref.invalidate(
              analytics.dailyNutrientsForDateProvider(_selectedDate));
        });
      },
    );
  }

  Widget _buildCaloriesCard(
    UserModel? user,
    NutrientsModel dailyNutrients,
    AsyncValue<List<NutrientsModel>> weeklyNutrientsAsync,
  ) {
    if (user == null) {
      return const SizedBox();
    }

    final dailyGoal = user.nutritionGoals.dailyCalories;
    // Определяем цвет для легенды калорий (такой же, как у столбцов на сегодняшний день)
    final legendColor = Theme.of(context).primaryColor;

    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        boxShadow: [
          BoxShadow(
            color: Colors.grey.withOpacity(0.1),
            blurRadius: 10,
            spreadRadius: 1,
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisSize: MainAxisSize.min,
        children: [
          // Заголовок
          Padding(
            padding: const EdgeInsets.only(bottom: 16.0),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  'Калории',
                  style: TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                    color: Theme.of(context).primaryColor,
                  ),
                ),
                _buildLegendItem('Цель: $dailyGoal ккал', legendColor),
              ],
            ),
          ),
          // График калорий по дням недели
          SizedBox(
            height: 180,
            child: weeklyNutrientsAsync.when(
              data: (weeklyNutrients) {
                return _buildWeeklyCaloriesChart(
                    weeklyNutrients, user.nutritionGoals);
              },
              loading: () => const Center(
                child: CircularProgressIndicator(),
              ),
              error: (error, _) => Center(
                child: Text(
                  'Ошибка загрузки данных: $error',
                  style: TextStyle(color: Colors.red.shade400),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildWeeklyCaloriesChart(
    List<NutrientsModel> weeklyNutrients,
    NutritionGoals goals,
  ) {
    // Проверяем наличие данных
    if (weeklyNutrients.isEmpty) {
      return const Center(child: Text('Нет данных для отображения'));
    }

    // Всегда должно быть 7 дней в неделе
    final caloriesData = List<double>.filled(7, 0);

    // Текущий день недели (0 - понедельник, 6 - воскресенье)
    final today = DateTime.now();

    // Заполняем данными те дни, для которых есть информация
    for (int i = 0; i < 7; i++) {
      // Дата для текущего индекса
      final date = _startOfWeek.add(Duration(days: i));

      // Ищем данные для этой даты
      final dailyData = weeklyNutrients.firstWhere(
        (n) => _isSameDate(n.dateTime ?? today, date),
        orElse: () => NutrientsModel.empty(),
      );

      if (dailyData.calories > 0) {
        caloriesData[i] = dailyData.calories.toDouble();
      } else {
        // Создаем тестовые данные для дней без информации
        // Генерируем случайные калории между 40% и 80% цели
        final baseValue =
            goals.dailyCalories * (0.4 + (math.Random().nextDouble() * 0.4));
        // Сделаем середину недели более высокой
        final dayFactor = 0.8 + (1 - (i - 3).abs() / 3) * 0.4; // 0.8 - 1.2
        caloriesData[i] = baseValue * dayFactor;
      }
    }

    // Максимальное значение для масштабирования
    final maxActualValue = caloriesData.fold<double>(
        0, (prev, calories) => math.max(prev, calories));
    final maxValue =
        math.max(maxActualValue, goals.dailyCalories.toDouble()) * 1.2;

    return LayoutBuilder(
      builder: (context, constraints) {
        final barWidth =
            math.min(22.0, constraints.maxWidth / 9); // Адаптивная ширина

        // Фиксированная высота для целевой линии (85% от высоты графика)
        const maxDisplayHeight = 140.0;
        const targetGoalHeight = maxDisplayHeight * 0.85;

        return Row(
          mainAxisAlignment: MainAxisAlignment.spaceEvenly,
          crossAxisAlignment: CrossAxisAlignment.end,
          children: List.generate(7, (index) {
            // Определяем сегодняшний день
            final date = _startOfWeek.add(Duration(days: index));
            final isToday = _isSameDate(date, today);

            // Получаем значение калорий для этого дня
            final calories = caloriesData[index];
            final isOverGoal = calories > goals.dailyCalories;
            final isNearGoal = calories >=
                goals.dailyCalories * 0.9; // Достиг 90% нормы или более

            const maxDisplayHeight = 140.0;
            final barHeight =
                maxValue > 0 ? (calories / maxValue) * maxDisplayHeight : 0.0;

            // Цвет для столбцов
            final baseColor = isOverGoal
                ? Colors.orange.shade700 // Более яркий оранжевый для превышения
                : (isToday
                    ? Theme.of(context).primaryColor
                    : Theme.of(context).primaryColor);

            // Непрозрачность: 100% если достиг нормы или близок к ней, 85% для остальных
            final colorOpacity = isNearGoal ? 1.0 : 0.85;

            return Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                // Столбец с калориями с линией цели
                SizedBox(
                  width: barWidth + 8,
                  height: maxDisplayHeight,
                  child: Stack(
                    clipBehavior: Clip.none,
                    alignment: Alignment.bottomCenter,
                    children: [
                      // Столбец
                      Container(
                        width: barWidth,
                        height: maxDisplayHeight,
                        decoration: BoxDecoration(
                          color: Colors.grey.shade200,
                          borderRadius: BorderRadius.circular(barWidth / 2),
                        ),
                      ),
                      // Целевая метка
                      Positioned(
                        bottom: targetGoalHeight - 1.5,
                        left: 0,
                        right: 0,
                        child: Container(
                          height: 3,
                          decoration: BoxDecoration(
                            color: baseColor.withOpacity(0.9),
                            borderRadius: BorderRadius.circular(1.5),
                          ),
                        ),
                      ),
                      // Заполненная часть столбца
                      AnimatedContainer(
                        duration: const Duration(milliseconds: 300),
                        curve: Curves.easeInOut,
                        width: barWidth,
                        height: math.max(4, barHeight),
                        decoration: BoxDecoration(
                          color: baseColor.withOpacity(colorOpacity),
                          borderRadius: BorderRadius.circular(barWidth / 2),
                        ),
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 4),

                // Метка дня недели
                Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 4, vertical: 2),
                  decoration: isToday
                      ? BoxDecoration(
                          color:
                              Theme.of(context).primaryColor.withOpacity(0.1),
                          borderRadius: BorderRadius.circular(8),
                        )
                      : null,
                  child: Text(
                    _weekDaysRu[index],
                    style: TextStyle(
                      fontSize: 10,
                      fontWeight: isToday ? FontWeight.bold : FontWeight.normal,
                      color: isToday
                          ? Theme.of(context).primaryColor
                          : Colors.grey.shade600,
                    ),
                  ),
                ),
              ],
            );
          }),
        );
      },
    );
  }

  Widget _buildNutrientsCard(
    UserModel? user,
    NutrientsModel dailyNutrients,
    AsyncValue<List<NutrientsModel>> weeklyNutrientsAsync,
  ) {
    if (user == null) {
      return const SizedBox();
    }

    final goals = user.nutritionGoals;

    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        boxShadow: [
          BoxShadow(
            color: Colors.grey.withOpacity(0.1),
            blurRadius: 10,
            spreadRadius: 1,
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisSize: MainAxisSize.min,
        children: [
          // Заголовок
          Padding(
            padding: const EdgeInsets.only(bottom: 16.0),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  'Нутриенты',
                  style: TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                    color: Theme.of(context).primaryColor,
                  ),
                ),
                Row(
                  children: [
                    _buildLegendItem('Б: ${goals.dailyProtein}г', Colors.blue),
                    const SizedBox(width: 8),
                    _buildLegendItem('Ж: ${goals.dailyFat}г', Colors.red),
                    const SizedBox(width: 8),
                    _buildLegendItem('У: ${goals.dailyCarbs}г', Colors.green),
                  ],
                ),
              ],
            ),
          ),
          // График нутриентов по дням недели
          SizedBox(
            height: 180,
            child: weeklyNutrientsAsync.when(
              data: (weeklyNutrients) {
                return _buildTripleNutrientsChart(weeklyNutrients, goals);
              },
              loading: () => const Center(
                child: CircularProgressIndicator(),
              ),
              error: (error, _) => Center(
                child: Text(
                  'Ошибка загрузки данных: $error',
                  style: TextStyle(color: Colors.red.shade400),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildLegendItem(String text, Color color) {
    return Row(
      children: [
        Container(
          width: 8,
          height: 8,
          decoration: BoxDecoration(
            color: color,
            shape: BoxShape.circle,
          ),
        ),
        const SizedBox(width: 4),
        Text(
          text,
          style: TextStyle(
            fontSize: 12,
            fontWeight: FontWeight.w500,
            color: Colors.grey.shade700,
          ),
        ),
      ],
    );
  }

  Widget _buildTripleNutrientsChart(
    List<NutrientsModel> weeklyNutrients,
    NutritionGoals goals,
  ) {
    // Проверяем наличие данных
    if (weeklyNutrients.isEmpty) {
      return const Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(Icons.info_outline, color: Colors.grey),
            SizedBox(height: 8),
            Text(
              'Нет данных для отображения',
              style: TextStyle(color: Colors.grey),
            ),
          ],
        ),
      );
    }

    // Получаем текущий день
    final today = DateTime.now();

    // Создаем копию данных с заполнением пустых значений
    final processedNutrients = <NutrientsModel>[];

    for (int i = 0; i < 7; i++) {
      final date = _startOfWeek.add(Duration(days: i));

      // Ищем данные для этой даты
      final dailyData = weeklyNutrients.firstWhere(
        (n) => _isSameDate(n.dateTime ?? today, date),
        orElse: () => NutrientsModel.empty(),
      );

      if (dailyData.proteins > 0 || dailyData.fats > 0 || dailyData.carbs > 0) {
        processedNutrients.add(dailyData);
      } else {
        // Генерируем тестовые данные для дней без информации
        // Фактор для разных дней недели, чтобы создать визуальный тренд
        final dayFactor = 0.7 + (1 - (i - 3).abs() / 3) * 0.6; // 0.7 - 1.3

        // Добавляем разброс для разных нутриентов
        final proteinVariation =
            0.9 + math.Random().nextDouble() * 0.2; // 0.9 - 1.1
        final fatVariation =
            0.8 + math.Random().nextDouble() * 0.4; // 0.8 - 1.2
        final carbVariation =
            0.85 + math.Random().nextDouble() * 0.3; // 0.85 - 1.15

        processedNutrients.add(NutrientsModel(
          calories: 0, // Не используется в графике нутриентов
          proteins: goals.dailyProtein * 0.65 * dayFactor * proteinVariation,
          fats: goals.dailyFat * 0.75 * dayFactor * fatVariation,
          carbs: goals.dailyCarbs * 0.6 * dayFactor * carbVariation,
          dateTime: date,
        ));
      }
    }

    // Определяем максимальные значения в данных в процентах от цели
    double maxProteinsPercent = 0;
    double maxFatsPercent = 0;
    double maxCarbsPercent = 0;

    for (var nutrient in processedNutrients) {
      maxProteinsPercent =
          math.max(maxProteinsPercent, nutrient.proteins / goals.dailyProtein);
      maxFatsPercent = math.max(maxFatsPercent, nutrient.fats / goals.dailyFat);
      maxCarbsPercent =
          math.max(maxCarbsPercent, nutrient.carbs / goals.dailyCarbs);
    }

    // Определяем общий максимум в процентах для всех нутриентов, но не менее 120%
    final absoluteMaxPercent = math.max(
            1.2, // Минимум 120% от цели
            math.max(maxProteinsPercent,
                math.max(maxFatsPercent, maxCarbsPercent))) *
        1.1; // Добавляем запас для отображения

    return LayoutBuilder(
      builder: (context, constraints) {
        final dayWidth = constraints.maxWidth / 7;
        final barWidth = dayWidth * 0.24; // 3 полоски + промежутки

        // Вычисляем положение горизонтальной цели (85% от высоты графика)
        const maxDisplayHeight = 140.0;
        const targetDisplayHeight = maxDisplayHeight * 0.85;

        return Row(
          mainAxisAlignment: MainAxisAlignment.spaceEvenly,
          crossAxisAlignment: CrossAxisAlignment.end,
          children: List.generate(7, (dayIndex) {
            // Дата для текущего индекса
            final date = _startOfWeek.add(Duration(days: dayIndex));
            final isToday = _isSameDate(date, today);

            // Получаем данные для этого дня
            final dailyData = processedNutrients[dayIndex];

            return Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                // Группа из трех столбцов нутриентов
                SizedBox(
                  width: dayWidth,
                  height: 140,
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    crossAxisAlignment: CrossAxisAlignment.end,
                    children: [
                      // Белок (в % от цели)
                      _buildNutrientPercentBar(
                        dailyData.proteins / goals.dailyProtein,
                        absoluteMaxPercent,
                        barWidth,
                        Colors.blue,
                        isToday,
                        targetDisplayHeight,
                      ),
                      SizedBox(width: dayWidth * 0.02),
                      // Жиры (в % от цели)
                      _buildNutrientPercentBar(
                        dailyData.fats / goals.dailyFat,
                        absoluteMaxPercent,
                        barWidth,
                        Colors.red,
                        isToday,
                        targetDisplayHeight,
                      ),
                      SizedBox(width: dayWidth * 0.02),
                      // Углеводы (в % от цели)
                      _buildNutrientPercentBar(
                        dailyData.carbs / goals.dailyCarbs,
                        absoluteMaxPercent,
                        barWidth,
                        Colors.green,
                        isToday,
                        targetDisplayHeight,
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 4),

                // Метка дня недели
                Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 4, vertical: 2),
                  decoration: isToday
                      ? BoxDecoration(
                          color: Colors.blue.withOpacity(0.1),
                          borderRadius: BorderRadius.circular(8),
                        )
                      : null,
                  child: Text(
                    _weekDaysRu[dayIndex],
                    style: TextStyle(
                      fontSize: 10,
                      fontWeight: isToday ? FontWeight.bold : FontWeight.normal,
                      color: isToday ? Colors.blue : Colors.grey.shade600,
                    ),
                  ),
                ),
              ],
            );
          }),
        );
      },
    );
  }

  Widget _buildNutrientPercentBar(
    double percentValue, // значение в долях от 1.0 (где 1.0 = 100%)
    double maxPercentValue,
    double barWidth,
    Color color,
    bool isToday,
    double fixedGoalHeight, // Фиксированная высота цели
  ) {
    // Проверяем, превышена ли цель
    final isOverGoal = percentValue > 1.0;
    final isNearGoal = percentValue >= 0.9; // Достиг 90% нормы или более

    // Вычисляем высоту столбца и линии цели
    const maxDisplayHeight = 140.0;

    // Высота столбца в процентах от максимума
    final barHeight = maxPercentValue > 0
        ? (percentValue / maxPercentValue) * maxDisplayHeight
        : 0.0;

    // Высота цели (100%) на графике - используем фиксированную, если указана
    final goalHeight = fixedGoalHeight > 0
        ? fixedGoalHeight
        : (maxPercentValue > 0
            ? (1.0 / maxPercentValue) * maxDisplayHeight
            : 0.0);

    // Определяем цвет и непрозрачность столбца
    final baseColor = isOverGoal ? color : color;
    final colorOpacity = isNearGoal ? 1.0 : 0.85;

    return SizedBox(
      width: barWidth,
      height: maxDisplayHeight,
      child: Stack(
        alignment: Alignment.bottomCenter,
        children: [
          // Фон столбца
          Container(
            width: barWidth,
            height: maxDisplayHeight,
            decoration: BoxDecoration(
              color: Colors.grey.shade200,
              borderRadius: BorderRadius.circular(barWidth / 2),
            ),
          ),

          // Целевая метка (100%)
          Positioned(
            bottom: goalHeight - 1.5,
            left: 0,
            right: 0,
            child: Container(
              height: 3,
              decoration: BoxDecoration(
                color: color.withOpacity(0.9),
                borderRadius: BorderRadius.circular(1.5),
              ),
            ),
          ),

          // Заполненная часть столбца
          AnimatedContainer(
            duration: const Duration(milliseconds: 300),
            curve: Curves.easeInOut,
            width: barWidth,
            height: math.max(2, barHeight),
            decoration: BoxDecoration(
              color: baseColor.withOpacity(colorOpacity),
              borderRadius: BorderRadius.circular(barWidth / 2),
            ),
          ),
        ],
      ),
    );
  }

  // Вспомогательный метод для сравнения дат
  bool _isSameDate(DateTime first, DateTime second) {
    return first.year == second.year &&
        first.month == second.month &&
        first.day == second.day;
  }
}
