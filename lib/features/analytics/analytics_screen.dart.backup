  Widget _buildBottomNavigationBar() {
    // Определяем цвет активной иконки и неактивных иконок
    final Color activeColor = Colors.blue;
    final Color inactiveColor = Colors.grey;

    return BottomAppBar(
      shape: const CircularNotchedRectangle(),
      notchMargin: 8,
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceAround,
        children: [
          IconButton(
            icon: Icon(Icons.home, color: inactiveColor),
            tooltip: context.tr('home'),
            onPressed: () {
              Navigator.of(context).pushReplacement(
                MaterialPageRoute(builder: (context) => const HomeScreen()),
              );
            },
          ),
          IconButton(
            icon: Icon(Icons.history, color: inactiveColor),
            tooltip: context.tr('history'),
            onPressed: () {
              Navigator.of(context).pushReplacement(
                MaterialPageRoute(
                  builder: (context) => const HistoryScreen(),
                ),
              );
            },
          ),
          const SizedBox(width: 40), // Место для FAB
          IconButton(
            icon: Icon(Icons.bar_chart, color: activeColor),
            tooltip: context.tr('analytics'),
            onPressed: () {
              // Уже на экране аналитики
            },
          ),
          IconButton(
            icon: Icon(Icons.person, color: inactiveColor),
            tooltip: context.tr('settings'),
            onPressed: () {
              Navigator.of(context).push(
                MaterialPageRoute(
                  builder: (context) => const ProfileSettingsScreen(),
                ),
              );
            },
          ),
        ],
      ),
    );
  }

  // Метод шаринга временно не используется (кнопка заменена на профиль)

  Widget _buildAddButton() {
    return FloatingActionButton(
      onPressed: () async {
        // Проверяем лимиты использования перед показом меню
        bool canContinue =
            await UsageLimitUtil.checkUsageLimitBeforeAction(context, ref);

        // Только если лимит не превышен, показываем меню добавления еды
        if (canContinue && mounted) {
          // Используем общий сервис для добавления еды
          final foodInputService =
              ref.read(services.foodInputServiceProvider)(ref, context);
          foodInputService.showAddFoodOptions(onFoodAdded: () {
            // Обновляем данные после добавления еды
            ref.invalidate(analytics.weeklyNutrientsProvider);
            ref.invalidate(
                analytics.dailyNutrientsForDateProvider(_selectedDate));
            ref.invalidate(analytics.weeklyWeightProvider);
            ref.invalidate(analytics.weeklyBodyMeasurementsProvider);
            // Также инвалидируем главный экран для синхронизации
            ref.invalidate(home.dailyMealsProvider);
            ref.invalidate(home.dailyNutrientsProvider);
          });
        }
      },
      child: const Icon(Icons.add),
    );
  }

  Widget _buildCaloriesCard(
    UserModel? user,
    MealNutrientsModel dailyNutrients,
    AsyncValue<List<MealNutrientsModel>> weeklyNutrientsAsync,
  ) {
    if (user == null) {
      return const SizedBox();
    }

    final dailyGoal = user.nutritionGoals.dailyCalories;
    // Определяем цвет для легенды калорий (такой же, как у столбцов на сегодняшний день)
    final legendColor = Theme.of(context).primaryColor;

    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        boxShadow: [
          BoxShadow(
            color: Colors.grey.withOpacity(0.1),
            blurRadius: 10,
            spreadRadius: 1,
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment:
            context.rtlCrossAxisAlignment(CrossAxisAlignment.start),
        mainAxisSize: MainAxisSize.min,
        children: [
          // Заголовок
          Padding(
            padding: const EdgeInsets.only(bottom: 16.0),
            child: Row(
              mainAxisAlignment:
                  context.rtlMainAxisAlignment(MainAxisAlignment.spaceBetween),
              children: [
                Expanded(
                  flex: 3,
                  child: Text(
                    context.tr('calories'),
                    style: TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                      color: Theme.of(context).primaryColor,
                    ),
                  ),
                ),
                Flexible(
                  flex: 2,
                  child: _buildLegendItem(
                      '${context.tr("goal_label")}: $dailyGoal ${context.tr("calories_suffix")}',
                      legendColor),
                ),
              ],
            ),
          ),
          // График калорий по дням недели
          SizedBox(
            height: 180,
            child: weeklyNutrientsAsync.when(
              data: (weeklyNutrients) {
                return _buildWeeklyCaloriesChart(
                    weeklyNutrients, user.nutritionGoals);
              },
              loading: () => const Center(
                child: CircularProgressIndicator(),
              ),
              error: (error, _) => Center(
                child: Text(
                  context.tr('data_loading_error'),
                  style: TextStyle(color: Colors.red.shade400),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildWeeklyCaloriesChart(
    List<MealNutrientsModel> weeklyNutrients,
    NutritionGoals goals,
  ) {
    // Получаем текущий день
    final today = DateTime.now();

    // Для отладки: выводим что приходит от провайдера
    print('Данные от провайдера weeklyNutrients:');
    for (var nutrient in weeklyNutrients) {
      print(
          'Дата: ${nutrient.dateTime}, Калории: ${nutrient.calories}, БЖУ: ${nutrient.proteins}/${nutrient.fats}/${nutrient.carbs}');
    }

    // Создаем копию данных с заполнением пустых значений
    final processedNutrients = <MealNutrientsModel>[];

    for (int i = 0; i < 7; i++) {
      final date = _startOfWeek.add(Duration(days: i));

      // Ищем данные для этой даты - используем простое сопоставление по индексу
      // Поскольку weeklyNutrients должен содержать данные в том же порядке (7 дней подряд)
      MealNutrientsModel dailyData;

      if (i < weeklyNutrients.length) {
        // Берем данные по индексу, они должны соответствовать дням недели
        dailyData = weeklyNutrients[i];

        // Проверяем корректность даты
        if (dailyData.dateTime == null) {
          dailyData = dailyData.copyWith(dateTime: date);
        }

        // 🎯 ТЕСТОВЫЕ ДАННЫЕ: Если нет реальных данных, генерируем тестовые для отображения графиков
        // ВРЕМЕННО ЗАКОММЕНТИРОВАНО ДЛЯ ПРОДАКШЕНА, НО ОСТАВЛЕНО ДЛЯ ПОСЛЕДУЮЩЕГО ТЕСТИРОВАНИЯ
        /*
        if (dailyData.calories == 0) {
          // Генерируем случайные калории между 70% и 110% цели
          final baseValue =
              goals.dailyCalories * (0.7 + (math.Random().nextDouble() * 0.4));
          // Сделаем середину недели более высокой
          final dayFactor = 0.8 + (1 - (i - 3).abs() / 3) * 0.4; // 0.8 - 1.2
          final testCalories = (baseValue * dayFactor).round();

          dailyData = dailyData.copyWith(
            calories: testCalories,
            dateTime: date,
          );

          print(
              '🎯 ТЕСТОВЫЕ ДАННЫЕ: День ${date.toIso8601String().substring(0, 10)} - сгенерировано $testCalories калорий');
        }
        */
      } else {
        // 🎯 ТЕСТОВЫЕ ДАННЫЕ: Если данных нет, создаем тестовые данные
        // ВРЕМЕННО ЗАКОММЕНТИРОВАНО ДЛЯ ПРОДАКШЕНА, НО ОСТАВЛЕНО ДЛЯ ПОСЛЕДУЮЩЕГО ТЕСТИРОВАНИЯ
        /*
        final baseValue =
            goals.dailyCalories * (0.7 + (math.Random().nextDouble() * 0.4));
        final dayFactor = 0.8 + (1 - (i - 3).abs() / 3) * 0.4;
        final testCalories = (baseValue * dayFactor).round();

        dailyData = MealNutrientsModel(
          calories: testCalories,
          proteins: 0,
          fats: 0,
          carbs: 0,
          dateTime: date,
        );

        print(
            '🎯 ТЕСТОВЫЕ ДАННЫЕ: День ${date.toIso8601String().substring(0, 10)} - создан объект с $testCalories калориями');
        */

        // Создаем пустой объект данных для дней без записей
        dailyData = MealNutrientsModel(
          calories: 0,
          proteins: 0,
          fats: 0,
          carbs: 0,
          dateTime: date,
        );
      }

      // Выводим для отладки
      print(
          'День ${date.toIso8601String().substring(0, 10)} - данные: ${dailyData.calories} калорий');

      processedNutrients.add(dailyData);
    }

    // Максимальное значение для масштабирования
    final maxActualValue = processedNutrients.fold<double>(
        0, (prev, nutrients) => math.max(prev, nutrients.calories.toDouble()));
    final maxValue =
        math.max(maxActualValue, goals.dailyCalories.toDouble()) * 1.2;

    return LayoutBuilder(
      builder: (context, constraints) {
        final barWidth =
            math.min(22.0, constraints.maxWidth / 9); // Адаптивная ширина

        // Фиксированная высота для целевой линии (85% от высоты графика)
        const maxDisplayHeight = 140.0;
        const targetGoalHeight = maxDisplayHeight * 0.85;

        return Row(
          mainAxisAlignment:
              context.rtlMainAxisAlignment(MainAxisAlignment.spaceEvenly),
          crossAxisAlignment: CrossAxisAlignment.end,
          children: List.generate(7, (index) {
            // Определяем сегодняшний день
            final date = _startOfWeek.add(Duration(days: index));
            final isToday = _isSameDate(date, today);

            // Получаем значение калорий для этого дня
            final calories = processedNutrients[index].calories.toDouble();
            final isOverGoal = calories > goals.dailyCalories;
            final isNearGoal = calories >=
                goals.dailyCalories * 0.9; // Достиг 90% нормы или более

            const maxDisplayHeight = 140.0;
            final barHeight =
                maxValue > 0 ? (calories / maxValue) * maxDisplayHeight : 0.0;

            // Цвет для столбцов
            final baseColor = isOverGoal
                ? Colors.orange.shade700 // Более яркий оранжевый для превышения
                : (isToday
                    ? Theme.of(context).primaryColor
                    : Theme.of(context).primaryColor);

            // Непрозрачность: 100% если достиг нормы или близок к ней, 85% для остальных
            final colorOpacity = isNearGoal ? 1.0 : 0.85;

            return Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                // Столбец с калориями с линией цели
                SizedBox(
                  width: barWidth + 8,
                  height: maxDisplayHeight,
                  child: Stack(
                    clipBehavior: Clip.none,
                    alignment: Alignment.bottomCenter,
                    children: [
                      // Столбец
                      Container(
                        width: barWidth,
                        height: maxDisplayHeight,
                        decoration: BoxDecoration(
                          color: Colors.grey.shade200,
                          borderRadius: BorderRadius.circular(barWidth / 2),
                        ),
                      ),
                      // Целевая метка
                      Positioned(
                        bottom: targetGoalHeight - 1.5,
                        left: 0,
                        right: 0,
                        child: Container(
                          height: 3,
                          decoration: BoxDecoration(
                            color: baseColor.withOpacity(0.9),
                            borderRadius: BorderRadius.circular(1.5),
                          ),
                        ),
                      ),
                      // Заполненная часть столбца
                      AnimatedContainer(
                        duration: const Duration(milliseconds: 300),
                        curve: Curves.easeInOut,
                        width: barWidth,
                        height: math.max(4, barHeight),
                        decoration: BoxDecoration(
                          color: baseColor.withOpacity(colorOpacity),
                          borderRadius: BorderRadius.circular(barWidth / 2),
                        ),
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 4),

                // Метка дня недели
                Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 4, vertical: 2),
                  decoration: isToday
                      ? BoxDecoration(
                          color:
                              Theme.of(context).primaryColor.withOpacity(0.1),
                          borderRadius: BorderRadius.circular(8),
                        )
                      : null,
                  child: Text(
                    _getLocalizedWeekdayShort(context, date.weekday),
                    style: TextStyle(
                      fontSize: 10,
                      fontWeight: isToday ? FontWeight.bold : FontWeight.normal,
                      color: isToday
                          ? Theme.of(context).primaryColor
                          : Colors.grey.shade600,
                    ),
                  ),
                ),
              ],
            );
          }),
        );
      },
    );
  }

  Widget _buildNutrientsCard(
    UserModel? user,
    MealNutrientsModel dailyNutrients,
    AsyncValue<List<MealNutrientsModel>> weeklyNutrientsAsync,
  ) {
    if (user == null) {
      return const SizedBox();
    }

    final goals = user.nutritionGoals;

    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        boxShadow: [
          BoxShadow(
            color: Colors.grey.withOpacity(0.1),
            blurRadius: 10,
            spreadRadius: 1,
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment:
            context.rtlCrossAxisAlignment(CrossAxisAlignment.start),
        mainAxisSize: MainAxisSize.min,
        children: [
          // Заголовок
          Padding(
            padding: const EdgeInsets.only(bottom: 16.0),
            child: Row(
              mainAxisAlignment:
                  context.rtlMainAxisAlignment(MainAxisAlignment.spaceBetween),
              children: [
                Expanded(
                  flex: 2,
                  child: Text(
                    context.tr('nutrients_summary'),
                    style: TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                      color: Theme.of(context).primaryColor,
                    ),
                  ),
                ),
                Flexible(
                  flex: 3,
                  child: SingleChildScrollView(
                    scrollDirection: Axis.horizontal,
                    child: Row(
                      children: [
                        _buildLegendItem(
                            '${context.tr("protein_short")}: ${goals.dailyProtein}${context.tr("grams_suffix")}',
                            Colors.blue),
                        const SizedBox(width: 6),
                        _buildLegendItem(
                            '${context.tr("fat_short")}: ${goals.dailyFat}${context.tr("grams_suffix")}',
                            Colors.red),
                        const SizedBox(width: 6),
                        _buildLegendItem(
                            '${context.tr("carbs_short")}: ${goals.dailyCarbs}${context.tr("grams_suffix")}',
                            Colors.green),
                      ],
                    ),
                  ),
                ),
              ],
            ),
          ),
          // График нутриентов по дням недели
          SizedBox(
            height: 180,
            child: weeklyNutrientsAsync.when(
              data: (weeklyNutrients) {
                return _buildTripleNutrientsChart(weeklyNutrients, goals);
              },
              loading: () => const Center(
                child: CircularProgressIndicator(),
              ),
              error: (error, _) => Center(
                child: Text(
                  context.tr('data_loading_error'),
                  style: TextStyle(color: Colors.red.shade400),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildLegendItem(String text, Color color) {
    return Row(
      children: [
        Container(
          width: 8,
          height: 8,
          decoration: BoxDecoration(
            color: color,
            shape: BoxShape.circle,
          ),
        ),
        const SizedBox(width: 4),
        Text(
          text,
          style: TextStyle(
            fontSize: 12,
            fontWeight: FontWeight.w500,
            color: Colors.grey.shade700,
          ),
        ),
      ],
    );
  }

  Widget _buildTripleNutrientsChart(
    List<MealNutrientsModel> weeklyNutrients,
    NutritionGoals goals,
  ) {
    // Проверяем наличие данных
    if (weeklyNutrients.isEmpty) {
      return Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(Icons.info_outline, color: Colors.grey),
            SizedBox(height: 8),
            Text(
              context.tr('no_data_to_display'),
              style: TextStyle(color: Colors.grey),
            ),
          ],
        ),
      );
    }

    // Получаем текущий день
    final today = DateTime.now();

    // Для отладки: выводим что приходит от провайдера
    print('Данные от провайдера для графика нутриентов:');
    for (var nutrient in weeklyNutrients) {
      print(
          'Дата: ${nutrient.dateTime}, Калории: ${nutrient.calories}, БЖУ: ${nutrient.proteins}/${nutrient.fats}/${nutrient.carbs}');
    }

    // Создаем копию данных с заполнением пустых значений
    final processedNutrients = <MealNutrientsModel>[];

    for (int i = 0; i < 7; i++) {
      final date = _startOfWeek.add(Duration(days: i));

      // Ищем данные для этой даты - используем простое сопоставление по индексу
      // Поскольку weeklyNutrients должен содержать данные в том же порядке (7 дней подряд)
      MealNutrientsModel dailyData;

      if (i < weeklyNutrients.length) {
        // Берем данные по индексу, они должны соответствовать дням недели
        dailyData = weeklyNutrients[i];

        // Проверяем корректность даты
        if (dailyData.dateTime == null) {
          dailyData = dailyData.copyWith(dateTime: date);
        }

        // 🎯 ТЕСТОВЫЕ ДАННЫЕ: Если нет реальных данных нутриентов, генерируем тестовые
        // ВРЕМЕННО ЗАКОММЕНТИРОВАНО ДЛЯ ПРОДАКШЕНА, НО ОСТАВЛЕНО ДЛЯ ПОСЛЕДУЮЩЕГО ТЕСТИРОВАНИЯ
        /*
        if (dailyData.proteins == 0 &&
            dailyData.fats == 0 &&
            dailyData.carbs == 0) {
          // Фактор для разных дней недели, чтобы создать визуальный тренд
          final dayFactor = 0.7 + (1 - (i - 3).abs() / 3) * 0.6; // 0.7 - 1.3

          // Добавляем разброс для разных нутриентов (70-110% от цели)
          final proteinVariation =
              0.7 + math.Random().nextDouble() * 0.4; // 70-110%
          final fatVariation =
              0.7 + math.Random().nextDouble() * 0.4; // 70-110%
          final carbVariation =
              0.7 + math.Random().nextDouble() * 0.4; // 70-110%

          dailyData = dailyData.copyWith(
            proteins: goals.dailyProtein * dayFactor * proteinVariation,
            fats: goals.dailyFat * dayFactor * fatVariation,
            carbs: goals.dailyCarbs * dayFactor * carbVariation,
            dateTime: date,
          );

          print(
              '🎯 ТЕСТОВЫЕ ДАННЫЕ НУТРИЕНТОВ: День ${date.toIso8601String().substring(0, 10)} - Б:${dailyData.proteins.toStringAsFixed(1)}г, Ж:${dailyData.fats.toStringAsFixed(1)}г, У:${dailyData.carbs.toStringAsFixed(1)}г');
        }
        */
      } else {
        // 🎯 ТЕСТОВЫЕ ДАННЫЕ: Если данных нет, создаем тестовые данные с нутриентами
        // ВРЕМЕННО ЗАКОММЕНТИРОВАНО ДЛЯ ПРОДАКШЕНА, НО ОСТАВЛЕНО ДЛЯ ПОСЛЕДУЮЩЕГО ТЕСТИРОВАНИЯ
        /*
        final dayFactor = 0.7 + (1 - (i - 3).abs() / 3) * 0.6; // 0.7 - 1.3
        final proteinVariation =
            0.7 + math.Random().nextDouble() * 0.4; // 70-110%
        final fatVariation = 0.7 + math.Random().nextDouble() * 0.4; // 70-110%
        final carbVariation = 0.7 + math.Random().nextDouble() * 0.4; // 70-110%

        dailyData = MealNutrientsModel(
          calories: 0, // Не используется в графике нутриентов
          proteins: goals.dailyProtein * dayFactor * proteinVariation,
          fats: goals.dailyFat * dayFactor * fatVariation,
          carbs: goals.dailyCarbs * dayFactor * carbVariation,
          dateTime: date,
        );

        print(
            '🎯 ТЕСТОВЫЕ ДАННЫЕ НУТРИЕНТОВ: День ${date.toIso8601String().substring(0, 10)} - создан объект с БЖУ: ${dailyData.proteins.toStringAsFixed(1)}/${dailyData.fats.toStringAsFixed(1)}/${dailyData.carbs.toStringAsFixed(1)}г');
        */

        // Создаем пустой объект данных для дней без записей
        dailyData = MealNutrientsModel(
          calories: 0,
          proteins: 0,
          fats: 0,
          carbs: 0,
          dateTime: date,
        );
      }

      // Выводим для отладки
      print(
          'День ${date.toIso8601String().substring(0, 10)} - данные: ${dailyData.calories} калорий');

      processedNutrients.add(dailyData);
    }

    // Определяем максимальные значения в данных в процентах от цели
    double maxProteinsPercent = 0;
    double maxFatsPercent = 0;
    double maxCarbsPercent = 0;

    for (var nutrient in processedNutrients) {
      maxProteinsPercent =
          math.max(maxProteinsPercent, nutrient.proteins / goals.dailyProtein);
      maxFatsPercent = math.max(maxFatsPercent, nutrient.fats / goals.dailyFat);
      maxCarbsPercent =
          math.max(maxCarbsPercent, nutrient.carbs / goals.dailyCarbs);
    }

    // Определяем общий максимум в процентах для всех нутриентов, но не менее 120%
    final absoluteMaxPercent = math.max(
            1.2, // Минимум 120% от цели
            math.max(maxProteinsPercent,
                math.max(maxFatsPercent, maxCarbsPercent))) *
        1.1; // Добавляем запас для отображения

    return LayoutBuilder(
      builder: (context, constraints) {
        final dayWidth = constraints.maxWidth / 7;
        final barWidth = dayWidth * 0.24; // 3 полоски + промежутки

        // Вычисляем положение горизонтальной цели (85% от высоты графика)
        const maxDisplayHeight = 140.0;
        const targetDisplayHeight = maxDisplayHeight * 0.85;

        return Row(
          mainAxisAlignment:
              context.rtlMainAxisAlignment(MainAxisAlignment.spaceEvenly),
          crossAxisAlignment: CrossAxisAlignment.end,
          children: List.generate(7, (dayIndex) {
            // Дата для текущего индекса
            final date = _startOfWeek.add(Duration(days: dayIndex));
            final isToday = _isSameDate(date, today);

            // Получаем данные для этого дня
            final dailyData = processedNutrients[dayIndex];

            return Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                // Группа из трех столбцов нутриентов
                SizedBox(
                  width: dayWidth,
                  height: 140,
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    crossAxisAlignment: CrossAxisAlignment.end,
                    children: [
                      // Белок (в % от цели)
                      _buildNutrientPercentBar(
                        dailyData.proteins / goals.dailyProtein,
                        absoluteMaxPercent,
                        barWidth,
                        Colors.blue,
                        isToday,
                        targetDisplayHeight,
                      ),
                      SizedBox(width: dayWidth * 0.02),
                      // Жиры (в % от цели)
                      _buildNutrientPercentBar(
                        dailyData.fats / goals.dailyFat,
                        absoluteMaxPercent,
                        barWidth,
                        Colors.red,
                        isToday,
                        targetDisplayHeight,
                      ),
                      SizedBox(width: dayWidth * 0.02),
                      // Углеводы (в % от цели)
                      _buildNutrientPercentBar(
                        dailyData.carbs / goals.dailyCarbs,
                        absoluteMaxPercent,
                        barWidth,
                        Colors.green,
                        isToday,
                        targetDisplayHeight,
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 4),

                // Метка дня недели
                Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 4, vertical: 2),
                  decoration: isToday
                      ? BoxDecoration(
                          color: Colors.blue.withOpacity(0.1),
                          borderRadius: BorderRadius.circular(8),
                        )
                      : null,
                  child: Text(
                    _getLocalizedWeekdayShort(context, date.weekday),
                    style: TextStyle(
                      fontSize: 10,
                      fontWeight: isToday ? FontWeight.bold : FontWeight.normal,
                      color: isToday ? Colors.blue : Colors.grey.shade600,
                    ),
                  ),
                ),
              ],
            );
          }),
        );
      },
    );
  }

  Widget _buildNutrientPercentBar(
    double percentValue, // значение в долях от 1.0 (где 1.0 = 100%)
    double maxPercentValue,
    double barWidth,
    Color color,
    bool isToday,
    double fixedGoalHeight, // Фиксированная высота цели
  ) {
    // Проверяем, превышена ли цель
    final isOverGoal = percentValue > 1.0;
    final isNearGoal = percentValue >= 0.9; // Достиг 90% нормы или более

    // Вычисляем высоту столбца и линии цели
    const maxDisplayHeight = 140.0;

    // Высота столбца в процентах от максимума
    final barHeight = maxPercentValue > 0
        ? (percentValue / maxPercentValue) * maxDisplayHeight
        : 0.0;

    // Высота цели (100%) на графике - используем фиксированную, если указана
    final goalHeight = fixedGoalHeight > 0
        ? fixedGoalHeight
        : (maxPercentValue > 0
            ? (1.0 / maxPercentValue) * maxDisplayHeight
            : 0.0);

    // Определяем цвет и непрозрачность столбца
    final baseColor = isOverGoal ? color : color;
    final colorOpacity = isNearGoal ? 1.0 : 0.85;

    return SizedBox(
      width: barWidth,
      height: maxDisplayHeight,
      child: Stack(
        alignment: Alignment.bottomCenter,
        children: [
          // Фон столбца
          Container(
            width: barWidth,
            height: maxDisplayHeight,
            decoration: BoxDecoration(
              color: Colors.grey.shade200,
              borderRadius: BorderRadius.circular(barWidth / 2),
            ),
          ),

          // Целевая метка (100%)
          Positioned(
            bottom: goalHeight - 1.5,
            left: 0,
            right: 0,
            child: Container(
              height: 3,
              decoration: BoxDecoration(
                color: color.withOpacity(0.9),
                borderRadius: BorderRadius.circular(1.5),
              ),
            ),
          ),

          // Заполненная часть столбца
          AnimatedContainer(
            duration: const Duration(milliseconds: 300),
            curve: Curves.easeInOut,
            width: barWidth,
            height: math.max(2, barHeight),
            decoration: BoxDecoration(
              color: baseColor.withOpacity(colorOpacity),
              borderRadius: BorderRadius.circular(barWidth / 2),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildWeightCard(
    AsyncValue<List<WeightEntryModel>> weeklyWeightAsync,
  ) {
    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        boxShadow: [
          BoxShadow(
            color: Colors.grey.withOpacity(0.1),
            blurRadius: 10,
            spreadRadius: 1,
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment:
            context.rtlCrossAxisAlignment(CrossAxisAlignment.start),
        mainAxisSize: MainAxisSize.min,
        children: [
          // Заголовок
          Padding(
            padding: const EdgeInsets.only(bottom: 16.0),
            child: Row(
              mainAxisAlignment:
                  context.rtlMainAxisAlignment(MainAxisAlignment.spaceBetween),
              children: [
                Text(
                  () {
                    final w = context.tr('weight');
                    return w.isNotEmpty
                        ? '${w[0].toUpperCase()}${w.substring(1)}'
                        : w;
                  }(),
                  style: TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                    color: Theme.of(context).primaryColor,
                  ),
                ),
              ],
            ),
          ),
          // График веса
          SizedBox(
            height: 180,
            child: weeklyWeightAsync.when(
              data: (weeklyWeights) {
                return WeightLineChart(weeklyWeights: weeklyWeights);
              },
              loading: () => const Center(
                child: CircularProgressIndicator(),
              ),
              error: (error, _) => Center(
                child: Text(
                  context.tr('data_loading_error'),
                  style: TextStyle(color: Colors.red.shade400),
                ),
              ),
            ),
          ),
          const SizedBox(height: 8),
          _buildCalendarGrid(),
        ],
      ),
    );
  }

  // Вспомогательный метод для сравнения дат
  bool _isSameDate(DateTime first, DateTime second) {
    return first.year == second.year &&
        first.month == second.month &&
        first.day == second.day;
  }

  Widget _buildCalendarGrid() {
    // Создаем контейнер для сетки дней недели
    return SizedBox(
      height: 30,
      child: LayoutBuilder(
        builder: (context, constraints) {
          // Используем те же отступы что и в графике веса
          const double graphLeftPad = 16.0;
          const double graphRightPad =
              24.0; // Соответствует новому отступу в графике

          // Рассчитываем позиции дней точно так же как в графике
          List<double> getDayPositions() {
            final startX = graphLeftPad;
            final endX = constraints.maxWidth - graphRightPad;
            final totalWidth = endX - startX;

            final positions = <double>[];
            for (int i = 0; i < 7; i++) {
              // Равномерно распределяем позиции от startX до endX (как в графике)
              final x = startX + (totalWidth * i / 6);
              positions.add(x);
            }
            return positions;
          }

          final dayPositions = getDayPositions();

          return Stack(
            children: List.generate(7, (index) {
              // Получаем день недели
              final weekday = _startOfWeek.add(Duration(days: index));

              // Определяем, является ли этот день текущим
              final now = DateTime.now();
              final isToday = now.year == weekday.year &&
                  now.month == weekday.month &&
                  now.day == weekday.day;

              return Positioned(
                left: dayPositions[index] -
                    20, // Центрируем текст относительно позиции
                child: SizedBox(
                  width: 40, // Фиксированная ширина для центрирования
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      Container(
                        padding: const EdgeInsets.symmetric(
                            horizontal: 6, vertical: 2),
                        decoration: isToday
                            ? BoxDecoration(
                                color: Theme.of(context)
                                    .primaryColor
                                    .withOpacity(0.1),
                                borderRadius: BorderRadius.circular(8),
                              )
                            : null,
                        child: Text(
                          _getLocalizedWeekdayShort(context, weekday.weekday),
                          textAlign: TextAlign.center,
                          style: TextStyle(
                            fontSize: 10,
                            fontWeight:
                                isToday ? FontWeight.bold : FontWeight.normal,
                            color: isToday
                                ? Theme.of(context).primaryColor
                                : Colors.grey.shade600,
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              );
            }),
          );
        },
      ),
    );
  }

  /// Создает переключатель типов замеров тела
  Widget _buildMeasurementTypeSelector() {
    final measurementTypes = [
      MeasurementType.chest,
      MeasurementType.waist,
      MeasurementType.hips,
      MeasurementType.leg,
      MeasurementType.arm,
      MeasurementType.shoulder,
      MeasurementType.belly,
    ];

    return SingleChildScrollView(
      scrollDirection: Axis.horizontal,
      child: Row(
        children: measurementTypes.map((type) {
          final isSelected = type == _selectedMeasurementType;
          return GestureDetector(
            onTap: () {
              setState(() {
                _selectedMeasurementType = type;
              });
            },
            child: Container(
              margin: const EdgeInsets.only(right: 8),
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
              decoration: BoxDecoration(
                color: isSelected
                    ? Theme.of(context).primaryColor.withOpacity(0.1)
                    : Colors.grey.shade100,
                borderRadius: BorderRadius.circular(20),
                border: Border.all(
                  color: isSelected
                      ? Theme.of(context).primaryColor
                      : Colors.grey.shade300,
                  width: 1,
                ),
              ),
              child: Text(
                context.tr(type.key),
                style: TextStyle(
                  fontSize: 12,
                  fontWeight: isSelected ? FontWeight.bold : FontWeight.normal,
                  color: isSelected
                      ? Theme.of(context).primaryColor
                      : Colors.grey.shade700,
                ),
              ),
            ),
          );
        }).toList(),
      ),
    );
  }

  // Метод для получения локализованного сокращенного названия дня недели
  String _getLocalizedWeekdayShort(BuildContext context, int weekday) {
    switch (weekday) {
      case DateTime.monday:
        return context.tr('monday_short');
      case DateTime.tuesday:
        return context.tr('tuesday_short');
      case DateTime.wednesday:
        return context.tr('wednesday_short');
      case DateTime.thursday:
        return context.tr('thursday_short');
      case DateTime.friday:
        return context.tr('friday_short');
      case DateTime.saturday:
        return context.tr('saturday_short');
      case DateTime.sunday:
        return context.tr('sunday_short');
      default:
        return '';
    }
  }
}
