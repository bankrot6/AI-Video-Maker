class AnalyticsScreen extends ConsumerStatefulWidget {
  const AnalyticsScreen({super.key});

  @override
  ConsumerState<AnalyticsScreen> createState() => _AnalyticsScreenState();
}

class _AnalyticsScreenState extends ConsumerState<AnalyticsScreen>
    with WidgetsBindingObserver {
  late DateTime _selectedDate;
  late DateTime _startOfWeek;
  late MeasurementType _selectedMeasurementType;

  @override
  void initState() {
    super.initState();
    // Добавляем наблюдатель жизненного цикла приложения
    WidgetsBinding.instance.addObserver(this);

    // Инициализируем локализацию для текущего варианта
    final localizationService = ref.read(appLocalizationServiceProvider);
    final locale = localizationService.getIntlLocaleString();
    initializeDateFormatting(locale, null);

    // Инициализируем выбранную дату как сегодня для обеспечения синхронизации
    _selectedDate = DateTime.now();
    _selectedMeasurementType = MeasurementType.chest;

    // Обновляем провайдер аналитики с текущей датой и принудительно обновляем данные
    WidgetsBinding.instance.addPostFrameCallback((_) {
      ref.read(analytics.selectedDateProvider.notifier).state = _selectedDate;
      // Принудительно инвалидируем провайдеры для загрузки свежих данных
      _refreshAnalyticsData();
    });
    _updateWeekRange();
  }

  @override
  void dispose() {
    // Удаляем наблюдатель жизненного цикла приложения
    WidgetsBinding.instance.removeObserver(this);
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    super.didChangeAppLifecycleState(state);
    // Обновляем данные при возвращении приложения в активное состояние
    if (state == AppLifecycleState.resumed && mounted) {
      debugPrint('📊 Приложение возобновлено, обновляем данные аналитики');
      _refreshAnalyticsData();
    }
  }

  /// Принудительно обновляет данные аналитики
  void _refreshAnalyticsData() {
    debugPrint('🔄 Принудительное обновление данных аналитики');
    ref.invalidate(analytics.weeklyNutrientsProvider);
    ref.invalidate(analytics.dailyNutrientsForDateProvider(_selectedDate));
    ref.invalidate(analytics.weeklyWeightProvider);
    ref.invalidate(analytics.weeklyBodyMeasurementsProvider);
  }

  void _updateWeekRange() {
    // Вычисляем первый день недели (понедельник)
    final weekday = _selectedDate.weekday;
    _startOfWeek = _selectedDate.subtract(Duration(days: weekday - 1));
    // Последний день недели (воскресенье) — вычисляем при необходимости
    // final endOfWeek = _startOfWeek.add(const Duration(days: 6));
  }

  @override
  Widget build(BuildContext context) {
    // Отслеживаем изменения провайдера выбранной даты (для синхронизации после добавления блюда)
    final providerSelectedDate = ref.watch(date_selector.selectedDateProvider);

    // Если дата в провайдере отличается от локальной - обновляем локальную
    if (_selectedDate.year != providerSelectedDate.year ||
        _selectedDate.month != providerSelectedDate.month ||
        _selectedDate.day != providerSelectedDate.day) {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (mounted) {
          setState(() {
            _selectedDate = providerSelectedDate;
          });
          // Принудительно обновляем провайдеры аналитики с новой датой
          ref.invalidate(
              analytics.dailyNutrientsForDateProvider(_selectedDate));
        }
      });
    }

    final user = ref.watch(home.currentUserProvider);
    final dailyNutrientsAsync =
        ref.watch(analytics.dailyNutrientsForDateProvider(_selectedDate));
    final weeklyNutrientsAsync = ref.watch(analytics.weeklyNutrientsProvider);
    final weeklyWeightAsync = ref.watch(analytics.weeklyWeightProvider);
    final weeklyBodyMeasurementsAsync = ref.watch(analytics.weeklyBodyMeasurementsProvider);

    // Получаем менеджер скриншотов
    final shareManager = ref.read(shareScreenManagerProvider);
    final screenshotKey = shareManager.getKeyForType(ScreenshotType.analytics);

    return RTLWrapper(
      child: Scaffold(
        backgroundColor: Colors.white,
        body: SafeArea(
          child: RefreshIndicator(
            onRefresh: () async {
              // Инвалидируем кэши при обновлении страницы
              ref.invalidate(analytics.weeklyNutrientsProvider);
              ref.invalidate(
                  analytics.dailyNutrientsForDateProvider(_selectedDate));
              ref.invalidate(analytics.weeklyWeightProvider);
              ref.invalidate(analytics.weeklyBodyMeasurementsProvider);
            },
            child: CustomScrollView(
              slivers: [
                // Шапка с логотипом и селектором даты
                SliverToBoxAdapter(
                  child: ScreenshotContainer(
                    boundaryKey: screenshotKey,
                    child: Column(
                      children: [
                        const SizedBox(height: 16),
                        // Верхняя часть (лого и календарь) — отдельно
                        WeekSelectorHeader(
                          showLogo: true,
                          showNotificationBadge: true,
                          notificationCount: 1,
                          initialDate: _selectedDate,
                          onWeekSelected: (startDate, endDate) {
                            setState(() {
                              _selectedDate = startDate;
                              _startOfWeek = startDate;
                            });
                            ref
                                .read(analytics.selectedDateProvider.notifier)
                                .state = _selectedDate;
                            ref.invalidate(analytics.weeklyNutrientsProvider);
                            ref.invalidate(analytics
                                .dailyNutrientsForDateProvider(_selectedDate));
                            ref.invalidate(analytics.weeklyWeightProvider);
                            ref.invalidate(analytics.weeklyBodyMeasurementsProvider);
