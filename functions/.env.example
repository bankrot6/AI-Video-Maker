# Appwrite connection (non-sensitive — copy to functions/.env and fill in)
APPWRITE_ENDPOINT=http://158.160.254.66/v1
APPWRITE_PROJECT_ID=6a6992ce000eae598752
APPWRITE_DATABASE_ID=main
APPWRITE_PRESETS_COLLECTION_ID=presets
APPWRITE_PRESET_IMAGES_BUCKET_ID=preset-images

# Cloud Scheduler cron for syncFromAppwrite (read at deploy from functions/.env)
SYNC_FROM_APPWRITE_SCHEDULE="0 */12 * * *"

# APPWRITE_API_KEY is a Firebase Secret — set it via:
#   firebase functions:secrets:set APPWRITE_API_KEY
# Do NOT put it in this file.
