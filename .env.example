# Google Cloud API Keys
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here
GOOGLE_CSE_API_KEY=your_google_custom_search_api_key_here
GOOGLE_CSE_ID=your_google_custom_search_engine_id_here
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Firebase (витрина фотосессий) - Приоритетное хранилище
# Получите эти данные из Firebase Console → Project Settings → General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
# Опционально: путь к JSON сервисного аккаунта для scripts/sync_appwrite_missing_to_firebase.mjs
# Если не указать — скрипт ищет ./firebase-service-account.json в корне репо (см. подсказку скрипта).
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/мой-ключ.json
# Двустороннее зеркалирование пресетов/генераций Appwrite↔Firebase (клиент)
DUAL_BACKEND_CLIENT_MIRROR=false
# То же поведение (зеркало БД + оба Storage): можно вместо строки выше
PHOTOSESSION_DUAL_STORAGE=false
# Для iOS (опционально)
FIREBASE_IOS_CLIENT_ID=
FIREBASE_IOS_BUNDLE_ID=
# Для Android (опционально)
FIREBASE_ANDROID_PACKAGE_NAME=

# Appwrite (витрина фотосессий) - ЗАКОММЕНТИРОВАНО, legacy
# APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=your_appwrite_project_id
# APPWRITE_API_KEY=
# APPWRITE_DATABASE_ID=photosession_db
# APPWRITE_PRESETS_COLLECTION_ID=presets
# APPWRITE_GENERATIONS_COLLECTION_ID=user_generations
# APPWRITE_STORAGE_BUCKET_ID=user-photos

# PiAPI
PIAPI_API_KEY=your_piapi_api_key_here
PIAPI_TASK_URL=https://api.piapi.ai/api/v1/task
PIAPI_BASE_URL=
PIAPI_UPLOAD_URL=https://upload.theapi.app/api/ephemeral_resource
PIAPI_SERVICE_MODE=
PIAPI_KLING_MODE=std
PIAPI_KLING_CFG_SCALE=0.5
PIAPI_KLING_ENABLE_AUDIO=false
PIAPI_KLING_VERSION=2.6
PIAPI_ZIMAGE_MODEL=Qubico/z-image
PIAPI_IMAGE_WIDTH=768
PIAPI_IMAGE_HEIGHT=768
PIAPI_IMAGE_SEED=-1
PIAPI_FLOW_SHIFT=3
PIAPI_BATCH_SIZE=1
PIAPI_NEGATIVE_PROMPT=
PIAPI_IMAGE_PROXY=
PIAPI_JOYCAPTION_MODEL=Qubico/joycaption
PIAPI_JOYCAPTION_TASK_TYPE=joycaption-beta-one
PIAPI_JOYCAPTION_PROMPT_STYLE=Descriptive
PIAPI_JOYCAPTION_CAPTION_LENGTH=any

# Google Gemini API (Приоритетный для генерации фотосессий)
# Используется напрямую через Google Vertex AI для генерации изображений
# При ошибках автоматически переключается на PiAPI как fallback
NANO_BANANA_API_KEY=your_google_api_key_here
NANO_BANANA_PROJECT_ID=your_google_cloud_project_id
NANO_BANANA_MODEL=gemini-2.5-flash-image
NANO_BANANA_LOCATION=global
NANO_BANANA_STREAM=true
NANO_BANANA_BASE_URL=

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SEC=60
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_GENDER=
ELEVENLABS_VOICE_AGE_GROUP=
ELEVENLABS_VOICE_AGE_GROUP_MALE=
ELEVENLABS_VOICE_AGE_GROUP_FEMALE=
ELEVENLABS_VOICE_LANGUAGE=ru-RU
ELEVENLABS_VOICE_IDS_MALE=
ELEVENLABS_VOICE_IDS_FEMALE=
ELEVENLABS_VOICE_IDS=
ELEVENLABS_VOICES=
ELEVENLABS_VOICE_SETTINGS={"stability":0.4,"similarity_boost":0.7,"style":0.2,"use_speaker_boost":true}

# VK Video API Key
# Получить токен можно на: https://dev.vk.com/
# Требуемые права: video (для доступа к video.search)
# Можно использовать:
#   - VKVIDEO_SERVICE_KEY (приоритетный)
#   - VK_API_TOKEN (альтернативный)
#   - VK_VIDEO_API_TOKEN (альтернативный)
VKVIDEO_SERVICE_KEY=your_vk_service_token_here
